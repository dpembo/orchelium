{
    "name": "Orchelium",
    "version": "1.0.0",
    "description": "Orchelium is a lightweight yet powerful solution for managing and scheduling shell-based executions across a local area network. Designed for IT administrators, Orchelium ensures secure, encrypted communication between a central hub and remotely managed agents. It streamlines job execution, scheduling, monitoring, and notifications while maintaining a simple yet effective approach to backup and automation.",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "node --experimental-vm-modules node_modules/.bin/jest",
        "test:verbose": "node --experimental-vm-modules node_modules/.bin/jest --verbose",
        "test:detail": "node --experimental-vm-modules node_modules/.bin/jest --verbose --no-coverage",
        "test:debug": "node --experimental-vm-modules node_modules/.bin/jest --verbose --bail --detectOpenHandles",
        "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
        "dev": "nodemon server.js"
    },
    "keywords": [
        "backup",
        "scheduling",
        "automation",
        "agent"
    ],
    "author": "Orchelium Contributors",
    "license": "MIT",
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "dependencies": {
        "@mdi/js": "^7.4.47",
        "archiver": "^8.0.0",
        "axios": "^1.15.0",
        "bcrypt": "^6.0.0",
        "chart.js": "^4.5.1",
        "cookie-parser": "^1.4.6",
        "ejs": "^5.0.2",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "form-data": "^4.0.6",
        "glob": "^13.0.6",
        "got": "^15.0.5",
        "js-yaml": "^4.3.2",
        "jsonwebtoken": "^9.0.3",
        "jws": "^4.0.1",
        "level": "^10.0.0",
        "log4js": "^6.9.1",
        "lusca": "^1.7.0",
        "marked": "^18.0.4",
        "material-design-icons-iconfont": "^6.7.0",
        "material-icons": "^1.13.14",
        "materialize-css": "^1.0.0",
        "moment-timezone": "^0.6.2",
        "monaco-editor": "^0.53.0",
        "mongoose": "^9.6.3",
        "mqtt": "^5.15.1",
        "multer": "^2.2.0",
        "nanoid": "^5.1.11",
        "node-schedule": "^2.1.1",
        "nodemailer": "^9.0.1",
        "passport": "^0.7.0",
        "passport-local": "^1.0.0",
        "passport-local-mongoose": "^9.1.0",
        "qs": "^6.15.1",
        "sanitize-html": "^2.17.0",
        "socket.io": "^4.7.5",
        "text-encoding-utf-8": "^1.0.2",
        "unzipper": "^0.12.5",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "ejs-lint": "^2.0.0",
        "jest": "^30.4.2",
        "nodemon": "^3.1.11",
        "reconnecting-websocket": "^4.4.0"
    }
}


