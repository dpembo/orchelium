                    </div>
                  </div>
                  <div class="row">
                    <div class="input-field col s8">
                      <input id="templateServer" type="text" name="templateServer" value="<%=serverConfig.templates.repositoryUrl%>" required>
                      <label for="templateServer">Templates Repository URL</label>
                    </div>
                  </div>
                  <div class="row">
                    <div class="input-field col s8">
                      
                      <span id="templaterefresh" onclick="refreshTemplates()" title="Refresh template list" style="cursor:pointer;font-size:20pt" class="material-icons vertMid tableIconButton ">refresh</span>
                      <label class="active" style="position:relative;left:30px;">Refresh Templates Cache</label>
                    </div>
                  </div>
                </div>
              </div>
              <% } %>

              <% if (hasPerm('settings.access')) { %>
              <div id="backup" class="col s12">
                <div class="container">
                  <h6 class="header blue-text" style="margin-bottom: 16px;">Backup &amp; Restore</h6>

                  <ul class="collapsible" id="backupAccordion">

                    <!-- Backup Section (open by default) -->
                    <li class="active">
                      <div class="collapsible-header"><i class="material-icons">cloud_download</i>Create Backup</div>
                      <div class="collapsible-body">
                        <p>Select what to include in your backup and download a zip file.</p>
                        <div id="backupItems" style="margin: 10px 0 20px 10px;">
                          <!-- Backup items will be dynamically loaded here -->
                        </div>
                        <button type="button" class="btn waves-effect waves-light blue" id="createBackupBtn">Download Backup</button>
                      </div>
                    </li>

                    <!-- Restore Section (collapsed by default) -->
                    <li>
                      <div class="collapsible-header"><i class="material-icons">cloud_upload</i>Restore from Backup</div>
                      <div class="collapsible-body">
                        <p>Upload a previously saved backup zip file to restore settings and data.</p>
                        <div class="card-panel light-blue lighten-5" style="padding: 15px; border-radius: 4px; margin: 0 0 16px 0;">
                          <strong class="blue-text">&#9888;&#65039; Warning:</strong> Restoring a backup will overwrite your current settings and data.
                          <strong>The server will need to be restarted</strong> for changes to take effect.
                        </div>
                        <div class="row">
                          <div class="file-field input-field col s6">
                            <div class="btn blue">
                              <span>Choose File</span>
                              <input type="file" id="backupFile" accept=".zip" />
                            </div>
                            <div class="file-path-wrapper">
                              <input class="file-path validate" type="text" placeholder="Select backup zip file" />
                            </div>
                          </div>
                        </div>
                        <button type="button" class="btn waves-effect waves-light orange" id="restoreBackupBtn">Restore Backup</button>
                        <div id="restoreMessage" style="margin-top: 20px; display: none;"></div>
                      </div>
                    </li>

                  </ul>
                </div>
              </div>
              <% } %>

              <!--<div id="test4" class="col s12">Test 4</div>-->

              <% if (hasPerm('settings.access')) { %>
              <div id="pluginmanager" class="col s12">
                <div class="container">
                  <h6 class="header blue-text" style="margin-bottom: 16px;">Plugin Manager</h6>
                  <p style="color:#666; margin-bottom: 20px;">
                    Configure the source repository for discovering/installing plugins (both official and community)
                  </p>

                  <div class="row"> 
                    <div class="input-field col s12">
                      <input id="pluginRegistryUrl" type="text" name="pluginRegistryUrl"
                        value="<%= serverConfig.pluginRegistry && serverConfig.pluginRegistry.url ? serverConfig.pluginRegistry.url : 'https://orchelium.com/plugins/registry/' %>">
                      <label for="pluginRegistryUrl" class="active">Registry URL</label>
                      <span class="helper-text">URL to the registry. Defaults to the official orchelium-plugins repository.</span>
                    </div>
                  </div>

                  <div class="row"> 
                    <div class="input-field col s12">
                      <input id="pluginCacheLocation" type="text" name="pluginCacheLocation"
                        value="<%= serverConfig.pluginRegistry && serverConfig.pluginRegistry.plugins ? serverConfig.pluginRegistry.plugins : 'plugins.json' %>">
                      <label for="pluginCacheLocation" class="active">Plugin Registry Location</label>
                      <span class="helper-text">Location to the plugin registry. Defaults to 'plugins.json'.</span>
                    </div>
                  </div>

                  <div class="row"> 
                    <div class="input-field col s12">
                      <input id="validationLocation" type="text" name="validationLocation"
                        value="<%= serverConfig.pluginRegistry && serverConfig.pluginRegistry.validation ? serverConfig.pluginRegistry.validation : 'validation-report.json' %>">
                      <label for="validationLocation" class="active">Validation Report Location</label>
                      <span class="helper-text">Location to the validation report. Defaults to 'validation-report.json'.</span>
                    </div>
                  </div>

                  <div class="row"> 
                    <div class="input-field col s12">
                      <input id="rejectedLocation" type="text" name="rejectedLocation"
                        value="<%= serverConfig.pluginRegistry && serverConfig.pluginRegistry.rejected ? serverConfig.pluginRegistry.rejected : 'rejected-plugins.json' %>">
                      <label for="rejectedLocation" class="active">Rejected Plugins Location</label>
                      <span class="helper-text">Location to the rejected plugins report. Defaults to 'rejected-plugins.json'.</span>
                    </div>
                  </div>

                  <div class="row"> 
                    <div class="input-field col s12">
                      <input id="iconsLocation" type="text" name="iconsLocation"
                        value="<%= serverConfig.pluginRegistry && serverConfig.pluginRegistry.icons ? serverConfig.pluginRegistry.icons : 'icons/' %>">
                      <label for="iconsLocation" class="active">Icons Location</label>
                      <span class="helper-text">Location to the plugin icons. Defaults to 'icons/'.</span>
                    </div>
                  </div>

                  <div class="row"> 
                    <div class="input-field col s12">
                      <input id="installsLocation" type="text" name="installsLocation"
                        value="<%= serverConfig.pluginRegistry && serverConfig.pluginRegistry.installs ? serverConfig.pluginRegistry.installs : 'installs/' %>">
                      <label for="installsLocation" class="active">Installs Location</label>
                      <span class="helper-text">Location to the plugin images. Defaults to 'installs/'.</span>
                    </div>
                  </div>


                </div>
              </div>
              <% } %>

            </div>




            <div class="row">
              <div class="col s12">
                <a href="#" id="saveChanges" class="btn waves-effect waves-light">Save Changes</a>
                <span style="float:right">
                  <a class="btn waves-effect waves-light orange" href="#" onclick="testEmail()">Notification Test</a>
                  <a class="btn waves-effect waves-light orange" href="#" onclick="testMqtt()">Restart MQTT Connection</a>
                </span>
              </div>
            </div>
          </form>
          <form id="encryption-key-form" action="/settings/encryption-key" method="POST" autocomplete="off"></form>
        </div>
      <br><br>


      </div>

      <%- include('./partials/_footer'); %>

      <%- include('./partials/_scripts'); %>
      <script>

        $(document).ready(function(){

            if (document.getElementById('backupAccordion')) {
              // Initialize backup accordion
              M.Collapsible.init(document.getElementById('backupAccordion'));

              // Initialize backup items
              loadBackupItems();

              $('#createBackupBtn').on('click', function(e) {
                e.preventDefault();
                createBackup();
              });

              $('#restoreBackupBtn').on('click', function(e) {
                e.preventDefault();
                const fileInput = document.getElementById('backupFile');
                const file = fileInput.files[0];

                if (!file) {
                  M.toast({html: 'Please select a backup file', displayLength: 5000});
                  return;
                }

                if (!file.name.endsWith('.zip')) {
                  M.toast({html: 'Please select a valid backup zip file', displayLength: 5000});
                  return;
                }

                restoreBackup(file);
              });
            }

            $('#saveChanges').on('click', function(e) {
              e.preventDefault();

              if (document.getElementById('icons')) {
                var items = getItems();

                // Validate that at least some icons exist
                if (!items || items.length === 0) {
                  M.toast({html: 'Please add at least one icon to the list', displayLength: 5000});
                  return;
                }

                document.getElementById('iconslist').value = items.join(',');
              }

              document.getElementById('settingsForm').submit();
            });

            if (document.getElementById('icons')) {
              $('#add-button').on('click', function(e) {
                  e.preventDefault();
                  const itemValue = $('#item-input').val().trim();
                  if (itemValue) {
                      addItemToList(itemValue);
                  }
              });

              $('#item-list').on('click', '.delete-btn', function() {
                  $(this).closest('li').remove();
              });
            }

            <%
            if(serverConfig.job_icons && Array.isArray(serverConfig.job_icons)){
              for(var ic=0;ic<serverConfig.job_icons.length;ic++) {
                var icon = serverConfig.job_icons[ic];
                if(icon && icon.trim() !== '') {%>
                  if (document.getElementById('icons')) {
                    addItemToList("<%=icon%>");
                  }
            <%  }
              }
            } %>

            function makeSortable() {
              if (!document.getElementById('item-list')) return;
                $('#item-list').sortable({
                    placeholder: "ui-sortable-placeholder",
                    helper: function(event, ui) {
                        var $helper = ui.clone().addClass('ui-sortable-helper');
                        $helper.css({
                            height: '30px', /* Adjust the height of the dragged item */
                            lineHeight: '30px' /* Adjust the line height to center text vertically */
                            
                        });
                        return $helper;
                    },
                    opacity: 0.7
                });
                $('#item-list').disableSelection();
            }

            function addItemToList(itemValue){
              //alert("adding: " + itemValue);
              const listItem = `<li class="collection-item list-item">
                        <i class="delete-btn material-icons vertMid" style="font-size:20pt">${itemValue}</i>
                        <span>${itemValue}</span>
                        <a href="#" title="delete" class="delete-btn material-icons vertMid" style="display:inline-block;float:right;font-size:20pt;">delete</a>
                    </li>`;
                    $('#item-list').append(listItem);
                    $('#item-input').val('');
                    makeSortable();
            }

            makeSortable();
        });


            
            $(document).ready(function(){
              $('.tabs').tabs();
              if (window.location.hash === '#secrets' || document.getElementById('shownEncryptionKey')) {
                var tabsEl = document.querySelector('.tabs');
                var tabs = tabsEl && M.Tabs.getInstance(tabsEl);
                if (tabs) tabs.select('secrets');
              }
            });

            $(document).ready(function(){
              $('select').formSelect();
            });

            $(document).ready(function(){
              $('.collapsible').collapsible();
            });

            // Check if the 'message' URL parameter is present
            const urlParams = new URLSearchParams(window.location.search);
            const message = urlParams.get('message');
            
            if (message) {
              // Show a Materialize toast notification with the provided message
              M.toast({html: message, displayLength: 5000});
            }

      </script>

    </body>

  </html>