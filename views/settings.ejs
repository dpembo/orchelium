      <script>
        function clearStoredSecret(input) {
          if (input.getAttribute('data-secret-mask') === '1' && input.value === <%- JSON.stringify(storedSecretMask) %>) {
            input.value = '';
          }
        }
        function restoreStoredSecret(input) {
          if (input.getAttribute('data-secret-mask') === '1' && input.value === '') {
            input.value = <%- JSON.stringify(storedSecretMask) %>;
          }
          if (window.M && M.updateTextFields) M.updateTextFields();
        }
        function generateEncryptionKey() {
          var bytes = new Uint8Array(32);
          crypto.getRandomValues(bytes);
          var hex = Array.from(bytes).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
          var field = document.getElementById('newEncryptionKey');
          field.removeAttribute('data-secret-mask');
          field.value = hex;
          if (window.M && M.updateTextFields) M.updateTextFields();
        }
      </script>
