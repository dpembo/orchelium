  <script>

  var order="desc";
  var sort="runDate";


  function toggleGroup(className) {
    // Get only PARENT rows (regular jobs and orchestration parents), NOT their children
    const allRows = document.querySelectorAll(`.toggle-row.${className}`);
    const rows = Array.from(allRows).filter(row => {
      // Exclude orchestration child rows - they are handled by orchestration parent toggle
      return !row.classList.contains('orch-child-expand') && !row.classList.toString().match(/orch-child-/);
    });
    
    var elem = document.getElementById("icon-" + className.split("-")[1]);
    if(elem.innerText=="expand_more"){
      elem.innerHTML = "expand_less";
    } else {
      elem.innerHTML="expand_more";
    }

    let delay = 0;
    
    rows.forEach(row => {
        if (row.style.display === "none") {
            // Show the row
            row.style.display = "table-row";
            
            // If showing an orchestration parent, ensure its children stay collapsed
            if (row.classList.contains('orch-parent')) {
                const safeId = row.getAttribute('data-safe-id');
                if (safeId) {
                    const orchChildren = document.querySelectorAll(`.orch-child-${safeId}`);
                    orchChildren.forEach(child => {
                        child.style.display = 'none';
                        child.classList.remove('show');
                    });
                    // Ensure icon shows expand_more
                    const orchIcon = document.getElementById(`orch-expand-${safeId}`);
                    if (orchIcon) {
                        orchIcon.textContent = 'expand_more';
                    }
                }
            }
            
            requestAnimationFrame(() => {
                row.style.transitionDelay = `${delay}ms`;
                row.classList.add('show');
                if(rows.length>10)delay += 10;
                else delay += 100;
            });
        } else {
            // Hide the row
            row.classList.remove('show');
            
            // If hiding an orchestration parent, collapse and hide its children
            if (row.classList.contains('orch-parent')) {
                const safeId = row.getAttribute('data-safe-id');
                if (safeId) {
                    const orchChildren = document.querySelectorAll(`.orch-child-${safeId}`);
                    orchChildren.forEach(child => {
                        child.classList.remove('show');
                        child.style.display = 'none';
                    });
                }
            }
            
            row.addEventListener('transitionend', function() {
                row.style.display = "none";
                row.style.transitionDelay = '0ms';
            }, { once: true });
        }
    });
}

  function toggleGroupOrig(groupId){

    const rows = document.querySelectorAll(`.toggle-row.${groupId}`);

        rows.forEach(row => {
            if (row.classList.contains('show')) {
                // Hide the row
                row.classList.remove('show');
            } else {
                // Show the row
                row.classList.add('show');
            }
        });
  }

  function showLogModal(icon, colour, name, logData) {
    document.getElementById('modal-log-data').textContent = logData || '';
    document.getElementById('modal-icon').textContent = icon;
    document.getElementById('modal-icon').style.color = colour;
    if(name.indexOf("||INTERNAL||")==0)name=name.substr(name.lastIndexOf("||")+2);
    document.getElementById('modal-jobname').textContent = name;
    var instance = M.Modal.getInstance(document.getElementById('logViewerModal'));
    instance.open();
  }

  function openModal(icon,colour,name,logId) {
    var source = document.getElementById(logId);
    var logData = source ? source.textContent : '';
    showLogModal(icon, colour, name, logData);
  }

  async function openOrchestrationNodeLog(jobIdEnc, nodeIdEnc, executionIdEnc, icon, colour, name, fallbackLogId) {
    const jobId = decodeURIComponent(jobIdEnc || '');
    const nodeId = decodeURIComponent(nodeIdEnc || '');
    const executionId = decodeURIComponent(executionIdEnc || '');
    let logData = '';

    if (jobId && nodeId) {
      try {
        const params = new URLSearchParams({ jobId, nodeId });
        if (executionId) {
          params.set('executionId', executionId);
        }
        const response = await fetch(`/orchestration/node/output?${params.toString()}`);
        if (response.ok) {
          const payload = await response.json();
          const stdout = payload && payload.log ? payload.log : '';
          const stderr = payload && payload.stderr ? payload.stderr : '';
          logData = stdout;
          if (stderr) {
            logData += (logData ? '\n\n' : '') + '[stderr]\n' + stderr;
          }
        }
      } catch (err) {
        console.warn('Unable to fetch orchestration node output:', err);
      }
    }

    if (!logData && fallbackLogId) {
      const fallbackNode = document.getElementById(fallbackLogId);
      if (fallbackNode) {
        logData = fallbackNode.textContent || '';
      }
    }

    if (!logData) {
      logData = 'No log output available for this node execution.';
    }

    showLogModal(icon, colour, name, logData);
  }

