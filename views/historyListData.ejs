<%
function isInternal(inItem){
  if(inItem.jobName.indexOf("||INTERNAL||")==0)return true;
  else return false;
}
function processInternalJob(inItem){
  if(inItem.jobName.indexOf("||INTERNAL||")==0){
    inItem.icon="restart_alt";
  }
  return inItem;
}


function formatNodeTypeLabel(type) {
  var t = String(type || '').toLowerCase();
  var map = {
    'start': 'Start',
    'end-success': 'Success',
    'end-failure': 'Failure',
    'end-fail': 'Failure',
    'execute': 'Script',
    'script': 'Script',
    'http': 'HTTP',
    'plugin': 'Plugin',
    'condition': 'Condition',
    'decision': 'Condition',
    'split-join': 'Split/Join',
    'split': 'Split',
    'join': 'Join',
    'delay': 'Delay',
    'wait': 'Wait',
    'notify': 'Notify',
    'notification': 'Notify'
  };
  if (map[t]) return map[t];
  if (!t) return 'Step';
  return t.replace(/[-_]/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
}

function getTriggerBadge(manual) {
  // Returns { key, label, title } for index-style run-badge
  if (manual === true || manual === 'true' || manual === 'manual') {
    return { key: 'manual', label: 'Manual', title: 'Manual Execution' };
  }
  if (manual === 'webhook') {
    return { key: 'webhook', label: 'Webhook', title: 'Webhook Triggered' };
  }
  if (manual === 'rule') {
    return { key: 'rule', label: 'Rule', title: 'Metric Rule Triggered' };
  }
  if (manual === 'threshold-cpu') {
    return { key: 'rule', label: 'Rule', title: 'CPU Threshold Exceeded' };
  }
  if (manual === 'threshold-disk') {
    return { key: 'rule', label: 'Rule', title: 'Mount Threshold Exceeded' };
  }
  if (manual === 'update') {
    return { key: 'manual', label: 'Update', title: 'Agent Update' };
  }
  return { key: 'schedule', label: 'Schedule', title: 'Scheduled Execution' };
}

function getSchedule(jobName){
  for(var i=0;i<schedules.length;i++)
  {
    if(schedules[i].jobName==jobName) return i;
  }
  return -1;
} 

function displaySecs(secs) {
  
  var ret;

  //Secs
  if (secs < 300) ret = secs + " secs";

  if (secs >= 300 && secs < 7200) {
    //Mins
    var mins = Math.floor(secs / 60);
    secs = secs % 60;

    ret = mins + " mins ";

  }
  if (secs >= 7200 && secs < 86400) {
    //hours
    var mins = Math.floor(secs / 60);
    var secs = secs % 60;
    var hours = Math.floor(mins / 60);
    mins = mins % 60;
    ret = hours + "h " + mins + " mins";
  }

  if (secs >= 86400) {
    var mins = Math.floor(secs / 60);
    var secs = secs % 60;
    var hours = Math.floor(mins / 60);
    var days = Math.floor(hours / 24);
    hours = hours - (days * 24);
    //hours = days %24;
    mins = mins % 60;
    ret = days + " days " + hours + "h ";

  }

  return ret;
}

var totalJobs = Array.isArray(historyList) ? historyList.length : 0;
var successfulJobs = 0;
var failedJobs = 0;

if (Array.isArray(historyList)) {
  for (var summaryIdx = 0; summaryIdx < historyList.length; summaryIdx++) {
    if (parseInt(historyList[summaryIdx].returnCode) === 0) {
      successfulJobs++;
    } else {
      failedJobs++;
    }
  }
}

%>

<tr id="history-summary-meta" data-total-jobs="<%=totalJobs%>" data-success-jobs="<%=successfulJobs%>" data-failed-jobs="<%=failedJobs%>" style="display:none;">
  <td colspan="8"></td>
</tr>

               
