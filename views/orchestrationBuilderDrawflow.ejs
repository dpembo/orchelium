  <script src="/js/drawflow/drawflow.min.js?v=df7"></script>
  <script src="/js/orchestration-drawflow-core.js?v=df21"></script>
  <script src="/js/orchestration-drawflow-editor.js?v=df32"></script>
  <script src="/js/orchestration-drawflow-properties.js?v=df29"></script>
  <script>
    let orchestrationId = '<%= typeof jobId !== "undefined" ? jobId : "" %>'.trim() || null;
    let orchestrationName = <%- JSON.stringify(typeof jobName !== 'undefined' ? jobName : '') %>;
    let orchestrationDescription = <%- JSON.stringify(typeof jobDescription !== 'undefined' ? jobDescription : '') %>;
    let orchestrationIcon = <%- JSON.stringify(typeof icon !== 'undefined' ? icon : 'workspaces') %>;
    let orchestrationColor = <%- JSON.stringify(typeof color !== 'undefined' ? color : '#FF9800') %>;

    window.closeDetailsPanel = function () {
      if (window.OrchProperties) OrchProperties.close();
    };

    window.selectNodeForProperties = function (node) {
      if (window.OrchProperties) OrchProperties.open(node);
    };

    window.availablePlugins = window.availablePlugins || [];


    function enterNameEditMode(ev) {
      if (ev) { ev.preventDefault(); ev.stopPropagation(); }
      var header = document.getElementById('orchestration-header');
      if (header) header.classList.add('name-edit-mode');
      var nameInput = document.getElementById('orch-name-input');
      var descInput = document.getElementById('orch-desc-input');
      if (nameInput) {
        nameInput.value = orchestrationName || '';
        setTimeout(function () { nameInput.focus(); nameInput.select(); }, 0);
      }
      if (descInput) descInput.value = orchestrationDescription || '';
    }

    function saveOrchestrationName(ev) {
      if (ev) { ev.preventDefault(); ev.stopPropagation(); }
      var nameInput = document.getElementById('orch-name-input');
      var descInput = document.getElementById('orch-desc-input');
      var name = nameInput ? nameInput.value.trim() : '';
      if (!name) {
        M.toast({ html: 'Name is required' });
        return;
      }
      orchestrationName = name;
      orchestrationDescription = descInput ? descInput.value.trim() : '';
      var nt = document.getElementById('orch-name-text');
      var dt = document.getElementById('orch-desc-text');
      if (nt) nt.textContent = orchestrationName;
      if (dt) dt.textContent = orchestrationDescription || 'No Description';
      cancelNameEdit();
    }

    function cancelNameEdit(ev) {
      if (ev) { ev.preventDefault(); ev.stopPropagation(); }
      var header = document.getElementById('orchestration-header');
      if (header) header.classList.remove('name-edit-mode');
    }

    function injectIconSelectPreviews() {
      var selectElement = document.getElementById('icon_select');
      if (!selectElement || !window.M || !M.FormSelect) return;
      var instance = M.FormSelect.getInstance(selectElement);
      if (!instance || !instance.dropdownOptions) return;
      var dropdownContent = instance.dropdownOptions;
      dropdownContent.querySelectorAll('li').forEach(function (li, index) {
        if (index === 0) return; // disabled placeholder
        var option = selectElement.querySelectorAll('option')[index];
        if (!option) return;
        var icon = option.getAttribute('data-icon') || option.value;
        // Remove previous inject
        var existing = li.querySelector('i.material-icons.orch-icon-opt');
        if (existing) existing.remove();
        var imgElement = li.querySelector('img');
        if (imgElement) imgElement.remove();
        var iconElement = document.createElement('i');
        iconElement.className = 'material-icons left orch-icon-opt';
        iconElement.style.position = 'relative';
        iconElement.style.top = '6px';
        iconElement.style.marginRight = '8px';
        iconElement.style.color = orchestrationColor || '#ff9800';
        iconElement.textContent = icon;
        li.prepend(iconElement);
      });
    }

    function ensureIconFormSelect() {
      var selectElement = document.getElementById('icon_select');
      if (!selectElement || !window.M || !M.FormSelect) return null;
      var instance = M.FormSelect.getInstance(selectElement);
      if (instance) {
        try { instance.destroy(); } catch (e) {}
      }
      instance = M.FormSelect.init(selectElement, {
        dropdownOptions: {
          constrainWidth: false,
          coverTrigger: false
        }
      });
      // Sync selected value
      if (orchestrationIcon) {
        selectElement.value = orchestrationIcon;
        if (instance && instance.input) {
          instance.input.value = orchestrationIcon;
        }
      }
      injectIconSelectPreviews();
      return instance;
    }

    function toggleIconEdit(ev) {
      if (ev) {
        ev.preventDefault();
        ev.stopPropagation();
      }
      var iconEdit = document.getElementById('orch-icon-edit');
      if (!iconEdit) return;
      var opening = !iconEdit.classList.contains('open');
      if (opening) {
        iconEdit.classList.add('open');
        iconEdit.style.display = 'block';
        var ii = document.getElementById('orch-icon-input');
        if (ii) ii.value = orchestrationIcon;
        ensureIconFormSelect();
        initOrchSpectrum(orchestrationColor);
        setOrchColor(orchestrationColor);
      } else {
        iconEdit.classList.remove('open');
        iconEdit.style.display = 'none';
      }
    }

    function updateIconPreview(selectItem) {
      if (!selectItem) return;
      document.getElementById('orch-icon-element').innerText = selectItem.value;
      document.getElementById('orch-icon-input').value = selectItem.value;
    }

    function initOrchSpectrum(inColor) {
      if (!window.jQuery || !jQuery.fn || !jQuery.fn.spectrum) return;
      var $picker = jQuery('#picker');
      if (!$picker.length) return;
      try {
        if ($picker.spectrum) {
          try { $picker.spectrum('destroy'); } catch (e) {}
        }
      } catch (e) {}
      $picker.spectrum({
        preferredFormat: 'hex',
        showInput: true,
        showInitial: true,
        color: inColor || '#FF9800',
        change: function (c) {
          if (!c) return;
          setOrchColor(c.toHexString());
        },
        move: function (c) {
          if (!c) return;
          var hex = c.toHexString();
          var colour = document.getElementById('colour');
          var hidden = document.getElementById('orch-color-input');
          if (colour) colour.value = hex;
          if (hidden) hidden.value = hex;
          var ie = document.getElementById('orch-icon-element');
          if (ie) ie.style.color = hex;
        }
      });
    }

    function setOrchColor(val) {
      if (!val) return;
      var hex = String(val).trim();
      if (hex && hex.charAt(0) !== '#') hex = '#' + hex;
      var colour = document.getElementById('colour');
      var hidden = document.getElementById('orch-color-input');
      var picker = document.getElementById('picker');
      if (colour) colour.value = hex;
      if (hidden) hidden.value = hex;
      if (picker) picker.value = hex;
      if (window.jQuery && jQuery.fn && jQuery.fn.spectrum) {
        try { jQuery('#picker').spectrum('set', hex); } catch (e) {}
      }
      var ie = document.getElementById('orch-icon-element');
      if (ie) ie.style.color = hex;
      // Refresh icon colours in dropdown previews
      document.querySelectorAll('#orch-icon-edit .orch-icon-opt').forEach(function (el) {
        el.style.color = hex;
      });
    }

    function saveIconEdit() {
      var iconInput = (document.getElementById('orch-icon-input') || {}).value || '';
      iconInput = String(iconInput).trim();
      var colorInput = (document.getElementById('orch-color-input') || {}).value || '';
      colorInput = String(colorInput).trim();
      if (!iconInput || !/^[a-zA-Z0-9_]+$/.test(iconInput)) {
        M.toast({ html: 'Please provide a valid icon name' });
        return;
      }
      if (!colorInput || !/^#[0-9A-Fa-f]{6}$/.test(colorInput)) {
        M.toast({ html: 'Please provide a valid hex colour (e.g. #FF9800)' });
        return;
      }
      orchestrationIcon = iconInput;
      orchestrationColor = colorInput;
      var ie = document.getElementById('orch-icon-element');
      if (ie) {
        ie.textContent = orchestrationIcon;
        ie.style.color = orchestrationColor;
      }
      cancelIconEdit();
    }

    function cancelIconEdit() {
      var iconEdit = document.getElementById('orch-icon-edit');
      if (iconEdit) {
        iconEdit.classList.remove('open');
        iconEdit.style.display = 'none';
      }
    }


    function updateExportButtonState() {
      const btn = document.getElementById('export-button');
      if (!btn) return;
      const canExport = Boolean(orchestrationId);
      btn.disabled = !canExport;
      btn.title = canExport
        ? 'Export this orchestration'
        : 'Save this orchestration before exporting';
    }

    function performSave() {
      const name = (orchestrationName || '').trim();
      if (!name) {
        M.toast({ html: 'Please set an orchestration name (click the title)' });
        enterNameEditMode();
        return;
      }
      const payload = OrchEditor.getOrchestrationPayload({
        jobId: orchestrationId,
        name: name,
        description: (orchestrationDescription || '').trim(),
        icon: orchestrationIcon || 'workspaces',
        color: orchestrationColor || '#FF9800'
      });
      const url = orchestrationId ? '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId) : '/rest/orchestration/jobs';
      const method = orchestrationId ? 'PUT' : 'POST';
      $.ajax({
        url: url, type: method, contentType: 'application/json', data: JSON.stringify(payload),
        success: function (result) {
          orchestrationId = result.job.id;
          M.toast({ html: 'Orchestration saved!' });
          updateExportButtonState();
          const editorUrl = '/orchestrationBuilder.html?id=' + encodeURIComponent(orchestrationId);
          if (window.location.pathname + window.location.search !== editorUrl) {
            window.history.replaceState({}, '', editorUrl);
          }
        },
        error: function (err) {
          M.toast({ html: 'Error saving: ' + ((err.responseJSON && err.responseJSON.error) || err.statusText) });
        }
      });
    }

    function saveOrchestration() {
      const name = (orchestrationName || '').trim();
      if (!name) {
        M.toast({ html: 'Please set an orchestration name (click the title)' });
        enterNameEditMode();
        return;
      }

      const errors = OrchEditor.validate();
      if (errors.length) {
        const list = document.getElementById('validation-errors-list');
        if (list) {
          list.innerHTML = errors.map(function (e) {
            return '<div style="margin-bottom:6px;">• ' + String(e).replace(/</g, '&lt;') + '</div>';
          }).join('');
        }
        const modalEl = document.getElementById('validation-errors-modal');
        if (modalEl && window.M) {
          let inst = M.Modal.getInstance(modalEl);
          if (!inst) inst = M.Modal.init(modalEl);
          inst.open();
          const anyway = document.getElementById('validation-save-anyway');
          if (anyway) {
            anyway.onclick = function (ev) {
              ev.preventDefault();
              inst.close();
              performSave();
            };
          }
        } else {
          // Fallback if Materialize modal unavailable
          if (window.confirm('Validation issues:\n\n• ' + errors.join('\n• ') + '\n\nSave anyway?')) {
            performSave();
          }
        }
        return;
      }
      performSave();
    }

    function exportCurrentOrchestration() {
      if (!orchestrationId) {
        M.toast({ html: 'Save this orchestration before exporting' });
        return;
      }
      window.location.href = '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId) + '/export';
    }

    function cancelOrchestrationChanges() {
      const modalEl = document.getElementById('discard-changes-modal');
      if (modalEl && window.M) {
        let inst = M.Modal.getInstance(modalEl);
        if (!inst) inst = M.Modal.init(modalEl);
        inst.open();
      } else if (window.confirm('Leave and discard unsaved changes?')) {
        discardOrchestrationChanges();
      }
    }

    function discardOrchestrationChanges() {
      window.location.href = '/orchestrationList.html';
    }

    function listSchedulesForOrchestration() {
      if (!orchestrationId) {
        M.toast({ html: 'Save the orchestration first to list related schedules' });
        return;
      }
      const container = document.getElementById('schedules-list-container');
      if (container) container.innerHTML = '<p style="color:#888;">Loading…</p>';
      $.ajax({
        url: '/api/schedules/by-orchestration/' + encodeURIComponent(orchestrationId),
        type: 'GET',
        dataType: 'json',
        success: function (data) {
          displaySchedulesList(data.schedules || []);
          const modalEl = document.getElementById('schedules-list-modal');
          if (modalEl && window.M) {
            let inst = M.Modal.getInstance(modalEl);
            if (!inst) inst = M.Modal.init(modalEl);
            inst.open();
          }
        },
        error: function () {
          M.toast({ html: 'Failed to fetch schedules' });
        }
      });
    }

    function displaySchedulesList(schedules) {
      const container = document.getElementById('schedules-list-container');
      if (!container) return;
      if (!schedules.length) {
        container.innerHTML = '<p style="color:#888;">No schedules currently use this orchestration.</p>';
        return;
      }
      container.innerHTML = schedules.map(function (s) {
        const name = s.name || s.id || 'Schedule';
        const id = s.id || '';
        return '<div style="padding:10px 12px;border:1px solid #e0e0e0;border-radius:4px;margin-bottom:8px;background:#fff;">' +
          '<strong>' + String(name).replace(/</g, '&lt;') + '</strong>' +
          (id ? '<div style="font-size:12px;color:#888;margin-top:4px;">' + String(id).replace(/</g, '&lt;') + '</div>' : '') +
          '</div>';
      }).join('');
    }

    function runOrchestration() {
      if (!orchestrationId) { M.toast({ html: 'Save the orchestration before running' }); return; }
      $.ajax({
        url: '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId) + '/execute',
        type: 'POST',
        success: function (result) {
          window.open('/orchestration/monitor.html?jobId=' + encodeURIComponent(orchestrationId) +
            '&executionId=' + encodeURIComponent(result.executionId), '_blank');
        },
        error: function (err) { M.toast({ html: 'Run failed: ' + err.statusText }); }
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      var paletteFilter = document.getElementById('palette-filter');
      if (paletteFilter) {
        paletteFilter.addEventListener('input', function () {
          const q = this.value.toLowerCase();
          document.querySelectorAll('.palette-item').forEach(function (item) {
            item.style.display = !q || item.textContent.toLowerCase().indexOf(q) >= 0 ? '' : 'none';
          });
        });
      }

      if (!window.OrchEditor) {
        console.error('OrchEditor failed to load — check orchestration-drawflow-editor.js');
        return;
      }
      OrchEditor.init({ containerId: 'drawflow', orchestrationId: orchestrationId });
      if (window.OrchProperties) OrchProperties.boot();
      if (window.M) {
        ['plugin-docs-modal', 'validation-errors-modal', 'schedules-list-modal', 'discard-changes-modal'].forEach(function (id) {
          const el = document.getElementById(id);
          if (el) M.Modal.init(el);
        });
      }
      updateExportButtonState();
      // Pre-init icon FormSelect so dropdown structure exists (previews injected on open)
      if (document.getElementById('icon_select') && window.M && M.FormSelect) {
        try { ensureIconFormSelect(); } catch (e) { console.warn('icon FormSelect', e); }
      }
      if (window.jQuery && jQuery.fn && jQuery.fn.spectrum) {
        try { initOrchSpectrum(orchestrationColor); } catch (e) {}
      }
      var nameInputEl = document.getElementById('orch-name-input');
      if (nameInputEl) {
        nameInputEl.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); saveOrchestrationName(); }
          if (e.key === 'Escape') { e.preventDefault(); cancelNameEdit(); }
        });
      }
      document.addEventListener('click', function (e) {
        var edit = document.getElementById('orch-icon-edit');
        if (!edit || !edit.classList.contains('open')) return;
        var disp = document.getElementById('orch-icon-display');
        if (disp && disp.contains(e.target)) return;
        if (edit.contains(e.target)) return;
        cancelIconEdit();
      });
      if (orchestrationId) {
        $.ajax({
          url: '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId),
          type: 'GET',
          success: function (orch) {
            if (orch.name) {
              orchestrationName = orch.name;
              var nt = document.getElementById('orch-name-text');
              if (nt) nt.textContent = orch.name;
            }
            if (orch.description) {
              orchestrationDescription = orch.description;
              var dt = document.getElementById('orch-desc-text');
              if (dt) dt.textContent = orch.description || 'No Description';
            }
            if (orch.icon) {
              orchestrationIcon = orch.icon;
              var ie = document.getElementById('orch-icon-element');
              if (ie) ie.textContent = orch.icon;
              var ii = document.getElementById('orch-icon-input');
              if (ii) ii.value = orch.icon;
            }
            if (orch.color) {
              orchestrationColor = orch.color;
              var ie2 = document.getElementById('orch-icon-element');
              if (ie2) ie2.style.color = orch.color;
              setOrchColor(orch.color);
            }
            OrchEditor.loadOrchestration(orch);
            updateExportButtonState();
          },
          error: function () { M.toast({ html: 'Failed to load orchestration' }); }
        });
      }
      $.ajax({
        url: '/rest/orchestration/plugins', type: 'GET',
        success: function (plugins) {
          window.availablePlugins = plugins || [];
          if (!plugins || !plugins.length) return;
          document.getElementById('plugin-palette-section').style.display = '';
          const host = document.getElementById('plugin-palette-items');
          plugins.forEach(function (p) {
            const name = p.name || p.id;
            const div = document.createElement('div');
            div.className = 'palette-item';
            div.draggable = true;
            div.dataset.nodeType = 'plugin';
            div.dataset.pluginName = name;
            div.innerHTML = '<i class="material-icons">extension</i><span>' + name + '</span>';
            host.appendChild(div);
            div.addEventListener('dragstart', function (e) {
              e.dataTransfer.setData('nodeType', 'plugin');
              e.dataTransfer.setData('pluginName', name);
            });
          });
        }
      });
    });
  </script>
</body>
</html>
