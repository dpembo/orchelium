            </div>
            <div id="prop-plugin-fields"></div>
            <div id="prop-plugin-docs-section" style="display: none; margin-top: 12px;">
              <button id="prop-plugin-docs-btn" type="button" onclick="openPluginDocs()" style="width: 100%; padding: 8px 12px; background: #1565c0; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 6px;">
                <i class="material-icons" style="font-size: 16px; line-height: 1;">description</i>
