<script>
  // Highlight the current page in the navigation
  document.addEventListener('DOMContentLoaded', function() {
    const currentPath = window.location.pathname;
    
    // Get all nav links (both desktop and mobile)
    const navLinks = document.querySelectorAll('ul.right a[href], ul#nav-mobile a[href]');
    
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      
      // Check if the current path matches the link href
      if (currentPath === href || currentPath.startsWith(href.replace('.html', ''))) {
        link.classList.add('active-nav-link');
      }
    });
  });
</script>

