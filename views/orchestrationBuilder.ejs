    function populatePluginPalette() {
      const container = document.getElementById('plugin-palette-items');
      const section = document.getElementById('plugin-palette-section');
      if (!container || !section) return;
      container.innerHTML = '';
      if (!availablePlugins.length) { section.style.display = 'none'; return; }
      availablePlugins.forEach(function(plugin) {
        const item = document.createElement('div');
        item.className = 'palette-item';
        item.draggable = true;
        item.dataset.nodeType = 'plugin';
        item.dataset.pluginName = plugin.name;
        const iconHtml = plugin.iconSvg
          ? '<img src="data:image/svg+xml,' + encodeURIComponent(plugin.iconSvg) + '" width="18" height="18" style="flex-shrink:0;vertical-align:middle;">'
          : '<i class="material-icons">extension</i>';
        item.innerHTML = iconHtml + '<span>' + escapeHtml(plugin.label || plugin.name) + '</span>';
        item.addEventListener('dragstart', function(e) {
          e.dataTransfer.setData('text/plain', 'plugin');
          e.dataTransfer.setData('plugin-name', plugin.name);
          draggedPaletteItem = item;
        });
        container.appendChild(item);
      });
      section.style.display = '';
      // Re-apply any active filter after repopulating
      applyPaletteFilter(document.getElementById('palette-filter').value);
    }

    function applyPaletteFilter(query) {
      const q = query.trim();
      const active = q.length >= 2;
      const lower = q.toLowerCase();
      document.querySelectorAll('#orchestration-palette .palette-item').forEach(function(item) {
        if (!active) {
          item.classList.remove('palette-hidden');
          return;
        }
        // Get the label text from the span inside the item
        const span = item.querySelector('span');
        const label = (span ? span.textContent : (item.dataset.pluginName || item.dataset.nodeType || '')).toLowerCase();
        item.classList.toggle('palette-hidden', label.indexOf(lower) === -1);
      });
      // Hide section headers whose every item is hidden
      document.querySelectorAll('#orchestration-palette .palette-section').forEach(function(section) {
        const items = section.querySelectorAll('.palette-item');
        const allHidden = items.length > 0 && Array.from(items).every(function(i) { return i.classList.contains('palette-hidden'); });
        section.classList.toggle('palette-section-hidden', allHidden);
      });
    }

    document.getElementById('palette-filter').addEventListener('input', function() {
      applyPaletteFilter(this.value);
    });

    function loadOrchestration() {
      $.ajax({
        url: '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId),
        type: 'GET',
        success: function(orch) {
          console.log('Loaded orchestration:', orch);
          
          if (!orch) {
            console.error('Empty response from server');
            return;
          }
          
          if (orch.nodes && orch.nodes.length > 0) {
            console.log('Loading', orch.nodes.length, 'nodes');
            orch.nodes.forEach(n => {
              nodeIdCounter = Math.max(nodeIdCounter, parseInt(n.id.split('_')[1]) || 0);
              
              let type = n.type;
              let icon = 'device_hub';
              let ports = [];
              
              if (type === 'start') {
                icon = 'play_arrow';
                ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
              } else if (type === 'execute') {
                const executeType = n.data?.executeType || 'script';
                icon = executeType === 'http' ? 'http' : 'settings';
                ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
              } else if (type === 'wait') {
                icon = 'schedule';
                ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
              } else if (type === 'notify') {
                icon = 'notifications';
                ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
              } else if (type === 'condition') {
                icon = 'device_hub';
                ports = [
                  { id: 'true', label: 'true', x: -28, y: 0 },
                  { id: 'false', label: 'false', x: 28, y: 0 }
                ];
              } else if (type === 'split-join') {
                icon = 'account_tree';
                const mode = (n.data && n.data.mode) ? n.data.mode : 'split';
                ports = getSplitJoinPorts(mode);
              } else if (type === 'end-success') {
                icon = 'check_circle';
              } else if (type === 'end-failure') {
                icon = 'error';
              } else if (type === 'plugin') {
                icon = 'extension';
                ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
              }
              
              nodes[n.id] = {
                id: n.id,
                type: type,
                label: n.label || 'Node',
                icon: icon,
                x: n.x || 100,
                y: n.y || 100,
                ports: ports,
                data: n.data || {}
              };

              ensureExecuteDefaults(nodes[n.id]);
              ensureWaitDefaults(nodes[n.id]);
              ensureNotifyDefaults(nodes[n.id]);
            });
          }
          
          if (orch.edges && orch.edges.length > 0) {
            console.log('Loading', orch.edges.length, 'edges');
            orch.edges.forEach(e => {
              edgeIdCounter = Math.max(edgeIdCounter, parseInt(e.id.split('_')[1]) || 0);
              edges.push({
                id: e.id,
                from: e.from,
                fromPort: e.fromPort,
                to: e.to,
                label: e.label,
                color: e.color || '#2196f3'
              });
            });
          }
          
          // Load name and description
          if (orch.name) {
            orchestrationName = orch.name;
            document.getElementById('orch-name-text').textContent = orchestrationName;
          }
          if (orch.description) {
            orchestrationDescription = orch.description;
          }
          
          // Load icon and color
          if (orch.icon) {
            orchestrationIcon = orch.icon;
          }
          if (orch.color) {
            orchestrationColor = orch.color;
          }
          
          // Update icon display
          document.getElementById('orch-icon-element').textContent = orchestrationIcon;
          document.getElementById('orch-icon-element').style.color = orchestrationColor;
          
          updateDescriptionDisplay();
          
          // Re-render all nodes to attach event handlers and connections
          renderAllNodes();
          updateStats();
          resetHistoryFromCurrentState();
          markOrchestrationSavedState();
          isLoadingOrchestration = false;
          console.log('Orchestration loaded - nodes:', Object.keys(nodes).length, 'edges:', edges.length);
          setIconDropDownValue(orch.icon);
          setColorPicker(orch.color);
          updateOrchestrationExportButtonState();
        },
        error: function(xhr, status, error) {
          isLoadingOrchestration = false;
          console.error('Failed to load orchestration:', error, xhr);
          alert('Failed to load orchestration: ' + error);
        }  
      });
      
    }
    
