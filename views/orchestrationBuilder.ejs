    function validateOrchestration() {
      const errors = [];
      
      // 1. Check for start node
      const startNode = Object.values(nodes).find(n => n.type === 'start');
      if (!startNode) {
        errors.push('Orchestration must have a Start node.');
      }
      
      // 2. Check all nodes for required fields
      Object.values(nodes).forEach(node => {
        if (node.type === 'execute') {
          const executeType = node.data?.executeType || 'script';

          if (executeType === 'http') {
            if (!node.data.httpUrl || !String(node.data.httpUrl).trim()) {
              errors.push(`HTTP node "${node.label}" is missing a URL.`);
            }

            const authType = node.data.httpAuthType || 'none';
            if (authType === 'bearer' && !String(node.data.httpAuthBearerToken || '').trim()) {
              errors.push(`HTTP node "${node.label}" is using Bearer auth but has no token.`);
            }
            if (authType === 'basic') {
              if (!String(node.data.httpAuthUsername || '').trim() || !String(node.data.httpAuthPassword || '').trim()) {
                errors.push(`HTTP node "${node.label}" is using Basic auth but username/password are incomplete.`);
              }
            }
            if (authType === 'apiKey') {
              if (!String(node.data.httpAuthApiKeyHeader || '').trim() || !String(node.data.httpAuthApiKeyValue || '').trim()) {
                errors.push(`HTTP node "${node.label}" is using API key auth but header/value are incomplete.`);
              }
            }
          } else {
            // Script mode requirements
            if (!node.data.script || !node.data.script.trim()) {
              errors.push(`Execute node "${node.label}" is missing a Script selection.`);
            }
            if (!node.data.agent || !node.data.agent.trim()) {
              errors.push(`Execute node "${node.label}" is missing a Target Agent selection.`);
            }
          }
        } else if (node.type === 'wait') {
          const waitSeconds = parseFloat(node.data?.waitSeconds);
          if (!Number.isFinite(waitSeconds) || waitSeconds <= 0) {
            errors.push(`Wait node "${node.label}" must have a delay greater than 0 seconds.`);
          }
        } else if (node.type === 'notify') {
          if (!String(node.data?.notifyTitle || '').trim()) {
            errors.push(`Notification node "${node.label}" is missing a title.`);
          }
          if (!String(node.data?.notifyBody || '').trim()) {
            errors.push(`Notification node "${node.label}" is missing a message.`);
          }
        } else if (node.type === 'condition') {
          // Check if condition node has both true and false paths
          const trueEdges = edges.filter(e => e.from === node.id && e.fromPort === 'true');
          const falseEdges = edges.filter(e => e.from === node.id && e.fromPort === 'false');
          
          if (trueEdges.length === 0) {
            errors.push(`Condition node "${node.label}" is missing a True path (left exit).`);
          }
          if (falseEdges.length === 0) {
            errors.push(`Condition node "${node.label}" is missing a False path (right exit).`);
          }
        } else if (node.type === 'plugin') {
          // Validate plugin node required fields (only for visible fields)
          if (!node.data.agent || !node.data.agent.trim()) {
            errors.push(`Plugin node "${node.label}" is missing a Target Agent selection.`);
          }
          const pluginName = node.data?.pluginName;
          if (pluginName) {
            const plugin = availablePlugins.find(function(p) { return p.name === pluginName; });
            if (plugin && plugin.inputs) {
              plugin.inputs.forEach(function(inputDef) {
                // Helper to check if field is visible (duplicate from form rendering)
                const isVisible = (function() {
                  if (!inputDef.visibleWhen) return true;
                  for (const [refFieldName, allowedValues] of Object.entries(inputDef.visibleWhen)) {
                    const refKey = 'plugin_input_' + refFieldName;
                    const currentValue = node.data?.[refKey];
                    if (allowedValues.includes(currentValue)) {
                      return true;
                    }
                  }
                  return false;
                })();
                
                if (isVisible && inputDef.required) {
                  const key = 'plugin_input_' + inputDef.name;
                  const value = node.data?.[key];
                  if (!value || String(value).trim() === '') {
                    errors.push(`Plugin node "${node.label}" is missing required field "${inputDef.label || inputDef.name}".`);
                  }
                }
              });
            }
          }
        } else if (node.type === 'split-join') {
          const mode = node.data?.mode || 'split';
          const outgoing = edges.filter(e => e.from === node.id);
          const incoming = edges.filter(e => e.to === node.id);

          if (mode === 'split') {
            if (outgoing.length < 2) {
              errors.push(`Split/Join node "${node.label}" in split mode must have at least 2 outgoing paths.`);
            }
          }

          if (mode === 'join') {
            if (incoming.length < 2) {
              errors.push(`Split/Join node "${node.label}" in join mode must have at least 2 incoming paths.`);
            }
            if (outgoing.length === 0) {
              errors.push(`Split/Join node "${node.label}" in join mode must have an outgoing path.`);
            }
          }
        }
      });
      
      // 3. Check for dangling node exits
      Object.values(nodes).forEach(node => {
        if (node.type !== 'start' && node.type !== 'end-success' && node.type !== 'end-failure' && node.type !== 'condition') {
          // Action nodes should have outgoing edges
          const outgoing = edges.filter(e => e.from === node.id);
          if (outgoing.length === 0) {
            errors.push(`Node "${node.label}" has no exit path. It must connect to another node or an end node.`);
          }
        }
        
        // End nodes should not have outgoing edges
        if (node.type === 'end-success' || node.type === 'end-failure') {
          const outgoing = edges.filter(e => e.from === node.id);
          if (outgoing.length > 0) {
            errors.push(`End node "${node.label}" should not have outgoing connections.`);
          }
        }
      });
      
      // 4. Check that at least one end node exists
      const endNodes = Object.values(nodes).filter(n => n.type === 'end-success' || n.type === 'end-failure');
      if (endNodes.length === 0) {
        errors.push('Orchestration must have at least one End node (Success or Failure).');
      }
      
      return errors;
    }
    
    function showValidationError(errors) {
      const errorMessageHtml = '<strong style="display: block; margin-bottom: 8px;">Orchestration is not valid:</strong>' + 
        errors.map(e => '<div style="margin-bottom: 4px;">• ' + e + '</div>').join('');
      
      M.toast({
        html: errorMessageHtml,
        displayLength: 8000,
        classes: 'validation-error-toast'
      });
    }
    
    function saveOrchestration() {
      // If we don't have a name yet, show the naming modal
      if (!orchestrationName.trim()) {
        pendingSave = true;
        document.getElementById('naming-modal-name').value = '';
        document.getElementById('naming-modal-desc').value = '';
        document.getElementById('naming-helper-text').innerHTML = '';
        document.getElementById('naming-modal-name').classList.remove('invalid');
        var modal = M.Modal.getInstance(document.getElementById('orchestration-naming-modal'));
        modal.open();
        return;
      }
      
      // Proceed with save
      performSave();
    }
    
    function performSave() {
      // Validate orchestration before saving
      const validationErrors = validateOrchestration();
      if (validationErrors.length > 0) {
        showValidationError(validationErrors);
        return;
      }
      const nodeArray = Object.values(nodes).map(n => ({
        id: n.id,
        label: n.label,
        type: n.type,
        icon: n.icon,
        x: n.x,
        y: n.y,
        data: n.data
      }));
      
      const edgeArray = edges.map(e => ({
        id: e.id,
        from: e.from,
        fromPort: e.fromPort,
        to: e.to,
        label: e.label,
        color: e.color
      }));
      
      const orchestration = {
        jobId: orchestrationId || 'new_' + Date.now(),
        name: orchestrationName,
        description: orchestrationDescription,
        icon: orchestrationIcon,
        color: orchestrationColor,
        nodes: nodeArray,
        edges: edgeArray
      };
      
      const url = orchestrationId ? '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId) : '/rest/orchestration/jobs';
      const method = orchestrationId ? 'PUT' : 'POST';
      
      $.ajax({
        url: url,
        type: method,
        contentType: 'application/json',
        data: JSON.stringify(orchestration),
        success: function(result) {
          orchestrationId = result.job.id;
          markOrchestrationSavedState();
          M.toast({html: 'Orchestration saved successfully!'});
          updateOrchestrationExportButtonState();
          // Stay in the editor after save and reflect the persisted id in the URL.
          const editorUrl = '/orchestrationBuilder.html?id=' + encodeURIComponent(orchestrationId);
          if (window.location.pathname + window.location.search !== editorUrl) {
            window.history.replaceState({}, '', editorUrl);
          }
        },
        error: function(err) {
          M.toast({html: 'Error saving orchestration: ' + err.statusText});
        }
      });
    }
    
    function runOrchestration() {
      // Check if orchestration has been saved
      if (!orchestrationId) {
        M.toast({html: 'Please save the orchestration before running it'});
        return;
      }
      
      // Show confirmation modal
      document.getElementById('exec-modal-name').textContent = orchestrationName;
      var modal = M.Modal.getInstance(document.getElementById('execution-confirmation-modal'));
      if (modal) {
        modal.open();
      } else {
        M.Modal.init(document.getElementById('execution-confirmation-modal')).open();
      }
    }
    
    function proceedWithExecution() {
      // Disable the button during execution
      const runButton = document.getElementById('run-button');
      if (runButton) {
        runButton.disabled = true;
        runButton.style.opacity = '0.6';
      }
      
      $.ajax({
        url: '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId) + '/execute',
        type: 'POST',
        contentType: 'application/json',
        success: function(result) {
          if (result.success && result.executionId) {
            M.toast({html: 'Orchestration execution started! (ID: ' + result.executionId + ')'});
            // Open monitor in new tab
            window.open('/orchestration/monitor.html?jobId=' + encodeURIComponent(orchestrationId) + '&executionId=' + encodeURIComponent(result.executionId), '_blank');
            // Close modal
            var modal = M.Modal.getInstance(document.getElementById('execution-confirmation-modal'));
            if (modal) {
              modal.close();
            }
            // Re-enable button
            if (runButton) {
              runButton.disabled = false;
              runButton.style.opacity = '1';
            }
          } else {
            M.toast({html: 'Failed to start orchestration execution'});
            // Re-enable button on failure
            if (runButton) {
              runButton.disabled = false;
              runButton.style.opacity = '1';
            }
          }
        },
        error: function(err) {
          M.toast({html: 'Error executing orchestration: ' + (err.responseJSON ? err.responseJSON.error : err.statusText)});
          if (runButton) {
            runButton.disabled = false;
            runButton.style.opacity = '1';
          }
        }
      });
    }
    
