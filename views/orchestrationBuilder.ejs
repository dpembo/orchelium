  <%- include('./partials/_header'); %>
  
  <div id="orchestration-container">
    <div id="orchestration-header">
      
      <h3 style="margin: 0; display: flex; align-items: center; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 5px; cursor: pointer;" id="orch-icon-display" title="Click to edit orchestration icon and color" >
          <i id="orch-icon-element" class="material-icons" style="color: #FF9800; font-size: 24px;" onclick="toggleIconEdit()"><%=icon%></i>
          <i id="orch-icon-indicator" class="material-icons" style="color: #000000; font-size:14px; position: relative; left: -14px; top: 11px;" onclick="toggleIconEdit()">schema</i>

          <div id="orch-icon-edit" style="display: none; border: 1px solid #ddd; border-radius: 4px; padding: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); min-width: 280px;">
            <label style="font-size: 11px; color: #999; text-transform: uppercase; display: block; margin-bottom: 4px;">Icon Name</label>
            <input type="hidden" id="orch-icon-input" placeholder="e.g., schema, backup, settings..." style="width: 100%; padding: 6px; border: 1px solid #ddd; border-radius: 3px; box-sizing: border-box; margin-bottom: 10px;">
            <select id="icon_select" name="icon" onchange="updateIconPreview(this);">
                <option value="" disabled>Select Icon</option>


                <% for(iconCount=0;iconCount<icons.length;iconCount++){%>
                
                  <option data-icon="<%=icons[iconCount]%>" value="<%=icons[iconCount]%>" <%=isSelected(icons[iconCount],icon)%>><%=icons[iconCount]%></option>

                <%
                }
                %>
              </select>
            <label style="font-size: 11px; color: #999; text-transform: uppercase; display: block; margin-bottom: 4px;">Colour (hex code)</label>
            <input type="hidden" id="orch-color-input" placeholder="#FF9800" style="width: 100%; padding: 6px; border: 1px solid #ddd; border-radius: 3px; box-sizing: border-box; margin-bottom: 10px;">
            <input onchange="setPickerColor(this.value);" type="text" value="<%=color%>" id="colour" name="colour" required>
            <span class="helper-text" data-error="Please provide a colour (e.g. #000000)"></span>
            <input type="text" id="picker" name="picker" value="<%=color%>" onchange="document.getElementById('colour').value=this.value;document.getElementById('orch-color-input').value=this.value;">
            
            <div class="orch-edit-buttons" style="gap: 4px;">
              <button onclick="saveIconEdit()" style="background: #4caf50; color: white; border: none; padding: 6px 12px; border-radius: 3px; cursor: pointer; font-size: 11px; flex: 1;">Save</button>
              <button onclick="cancelIconEdit()" style="background: #999; color: white; border: none; padding: 6px 12px; border-radius: 3px; cursor: pointer; font-size: 11px; flex: 1;">Cancel</button>
            </div>
          </div>
        </div>
        <div id="orch-name-display" title="Click to edit orchestration name">
          <span id="orch-name-text">Orchestration</span>
          <span id="orch-desc-text" title="Orchestration description">No Description</span>
        </div>
        <div id="orch-name-edit">
          <div>
            <label style="font-size: 11px; color: #999; text-transform: uppercase; display: block; margin-bottom: 4px;">Name</label>
            <input type="text" id="orch-name-input" placeholder="Orchestration name...">
          </div>
          <div>
            <label style="font-size: 11px; color: #999; text-transform: uppercase; display: block; margin-bottom: 4px;">Description</label>
            <textarea id="orch-desc-input" placeholder="Optional description..."></textarea>
          </div>
          <div class="orch-edit-buttons">
            <button onclick="saveOrchestrationName()" style="background: #4caf50; color: white; border: none; padding: 6px 14px; border-radius: 3px; cursor: pointer; font-size: 12px;">Save</button>
            <button onclick="cancelNameEdit()" style="background: #999; color: white; border: none; padding: 6px 14px; border-radius: 3px; cursor: pointer; font-size: 12px;">Cancel</button>
          </div>
        </div>
      </h3>
      <div id="header-buttonss">
        <div class="header-toolbar" role="toolbar" aria-label="Orchestration actions">
          <div class="toolbar-group">
            <button id="undo-button" class="header-action-btn" onclick="undoGraphChange()" title="Undo last change" disabled>
              <i class="material-icons">undo</i>
              Undo
            </button>
            <button id="redo-button" class="header-action-btn" onclick="redoGraphChange()" title="Redo last undone change" disabled>
              <i class="material-icons">redo</i>
              Redo
            </button>
          </div>
          <span class="toolbar-divider" aria-hidden="true"></span>
          <div class="toolbar-group">
            <button class="header-action-btn" onclick="listSchedulesForOrchestration()" title="View schedules that use this orchestration">
              <i class="material-icons">assignment</i>
              List Jobs
            </button>
            <button id="run-button" class="header-action-btn" onclick="runOrchestration()" title="Execute the orchestration">
              <i class="material-icons">play_arrow</i>
              Run
            </button>
            <button class="header-action-btn" onclick="cancelOrchestrationChanges()" title="Discard changes and return to list">
              <i class="material-icons">cancel</i>
              Cancel
            </button>
            <button id="export-button" class="header-action-btn" onclick="exportCurrentOrchestration()" title="Save this orchestration before exporting" disabled>
              <i class="material-icons">download</i>
              Export
            </button>
            <button class="header-action-btn toolbar-primary" onclick="saveOrchestration()">
              <i class="material-icons">save</i>
              Save
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <div id="orchestration-main">
      <!-- Palette -->
      <div id="orchestration-palette">
        <div id="palette-filter-wrap">
          <input id="palette-filter" type="text" placeholder="Filter nodes..." autocomplete="off">
        </div>
        <div class="palette-section">
          <h4>Start / End</h4>
          <div class="end-nodes-container">
            <div class="palette-item" draggable="true" data-node-type="start">
              <i class="material-icons" style="color: #4caf50;">play_arrow</i>
              <span>Start</span>
            </div>
            <div class="palette-item" draggable="true" data-node-type="end-success">
              <i class="material-icons" style="color: #4caf50;">check_circle</i>
              <span>Success</span>
            </div>
            <div class="palette-item" draggable="true" data-node-type="end-failure">
              <i class="material-icons" style="color: #f44336;">error</i>
              <span>Failure</span>
            </div>
          </div>
        </div>
        <div class="palette-section">
          <h4>Logic</h4>
          <div class="logic-nodes-container">
            <div class="palette-item" draggable="true" data-node-type="condition">
              <div class="logic-node-content">
                <i class="material-icons">call_split</i>
                <span>if</span>
              </div>
            </div>
            <div class="palette-item" draggable="true" data-node-type="split-join">
              <div class="logic-node-content">
                <i class="material-icons">account_tree</i>
                <span class="logic-label-splitjoin">Split<br>Join</span>
              </div>
            </div>
          </div>
        </div>

        <div class="palette-section">
          <h4>Core Steps</h4>
          <div class="palette-item" draggable="true" data-node-type="execute">
            <i class="material-icons">settings</i>
            <span>Execute Script</span>
          </div>
          <div class="palette-item" draggable="true" data-node-type="execute-http">
            <i class="material-icons">http</i>
            <span>HTTP Request</span>
          </div>
          <div class="palette-item" draggable="true" data-node-type="wait">
            <i class="material-icons">schedule</i>
            <span>Wait</span>
          </div>
          <div class="palette-item" draggable="true" data-node-type="notify">
            <i class="material-icons">notifications</i>
            <span>Notify</span>
          </div>
        </div>
        
        <div class="palette-section" id="plugin-palette-section" style="display:none;">
          <h4>Integration Steps</h4>
          <div id="plugin-palette-items"></div>
        </div>
        


<!--        
        <hr />
        <p style="font-size: 12px; color: #999; margin-top: 20px;">
          <strong>Drag items</strong> from this palette onto the canvas to build your orchestration.
        </p>
-->
      </div>
      
      <!-- Canvas -->
      <div id="orchestration-canvas">
        <svg id="orchestration-svg">
          <defs>
            <marker id="arrowhead" markerWidth="8" markerHeight="8" refX="8" refY="4" viewBox="0 0 8 8" orient="auto" markerUnits="userSpaceOnUse">
              <polygon points="0 0, 8 4, 0 8" fill="#333" />
            </marker>
          </defs>
        </svg>
      </div>
      <!-- Zoom Controls (Fixed to viewport) -->
      <div id="zoom-controls" style="position: fixed; bottom: 80px; background: white; border: 1px solid #ddd; border-radius: 4px; display: flex; gap: 5px; padding: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 100; transition: right 0.3s ease-in-out;">
        <button id="zoom-out" style="width: 32px; height: 32px; border: 1px solid #ddd; background: white; border-radius: 3px; cursor: pointer; font-size: 14px; font-weight: bold; color: #333;" title="Zoom Out">−</button>
        <div id="zoom-level" style="min-width: 50px; text-align: center; line-height: 32px; font-size: 12px; color: #666; font-weight: 500;">100%</div>
        <button id="zoom-in" style="width: 32px; height: 32px; border: 1px solid #ddd; background: white; border-radius: 3px; cursor: pointer; font-size: 14px; font-weight: bold; color: #333;" title="Zoom In">+</button>
        <button id="zoom-reset" style="width: 32px; height: 32px; border: 1px solid #ddd; background: white; border-radius: 3px; cursor: pointer; font-size: 11px; font-weight: bold; color: #333;" title="Reset Zoom">↻</button>
        <button id="zoom-auto-layout" style="width: 32px; height: 32px; border: 1px solid #ddd; background: white; border-radius: 3px; cursor: pointer; font-size: 17px; font-weight: bold; color: #333; line-height: 1;" title="Auto Layout">⤧</button>
      </div>
      
      <!-- Properties -->
      <div id="orchestration-properties">
        <div id="properties-empty" style="text-align: center; color: #999;">
          <p><i class="material-icons" style="font-size: 48px; display: block; margin-bottom: 10px; color: #ddd;">touch_app</i></p>
          <p><strong>Select a node</strong> on the canvas to edit its properties</p>
        </div>
        <div id="properties-content" style="display: none;">
          <div class="properties-section">
            <button onclick="closeDetailsPanel()" class="details-close-btn" id="detailsClose" title="Close">&times;</button>
            <label>Node Type</label>
            <p id="prop-type" style="margin: 5px 0; font-size: 13px; color: #333;"></p>
          </div>

          <div id="prop-action-name-section" class="properties-section" style="display: none;">
            <label for="prop-action-name">Name (optional)</label>
            <input type="text" id="prop-action-name" placeholder="Custom display name...">
            <div style="margin-top: 4px; font-size: 0.82em; color: var(--text-muted, #888);">
              Template alias: <code id="prop-alias-display" style="font-size: 0.9em;"></code>
            </div>
          </div>
          
          <div id="prop-execute" style="display: none;">
            <div class="properties-section">
              <label for="prop-execute-type">Execute Type</label>
              <select id="prop-execute-type">
                <option value="script">Script</option>
                <option value="http">HTTP Request</option>
              </select>
            </div>

            <div id="prop-execute-script-fields">
            <div class="properties-section">
              <label for="prop-script">Script</label>
              <select id="prop-script"></select>
            </div>
            <div class="properties-section">
              <label for="prop-agent">Target Agent</label>
              <select id="prop-agent"></select>
            </div>
            <div class="properties-section" id="prop-script-info">
              <div id="prop-script-info-detail"></div>
            </div>
            <div class="properties-section">
              <label for="prop-params">Parameters</label>
              <textarea id="prop-params" placeholder="Enter command parameters or custom command"></textarea>
            </div>
            <div class="properties-section">
              <label for="prop-script-timeout">Timeout (ms)</label>
              <input type="number" id="prop-script-timeout" min="1000" step="1000" placeholder="3600000" title="Script execution timeout in milliseconds">
            </div>
            </div>

            <div id="prop-execute-http-fields" style="display: none;">
              <div class="properties-section">
                <label for="prop-http-method">Method</label>
                <select id="prop-http-method">
                  <option value="GET">GET</option>
                  <option value="POST">POST</option>
                  <option value="PUT">PUT</option>
                  <option value="PATCH">PATCH</option>
                  <option value="DELETE">DELETE</option>
                  <option value="HEAD">HEAD</option>
                  <option value="OPTIONS">OPTIONS</option>
                </select>
              </div>
              <div class="properties-section">
                <label for="prop-http-url">URL</label>
                <input type="text" id="prop-http-url" placeholder="https://api.example.com/v1/resource">
              </div>
              <div class="properties-section">
                <label for="prop-http-timeout">Timeout (ms)</label>
                <input type="number" id="prop-http-timeout" min="1000" step="1000" placeholder="30000">
              </div>
              <div class="properties-section">
                <label for="prop-http-auth-type">Authentication</label>
                <select id="prop-http-auth-type">
                  <option value="none">None</option>
                  <option value="bearer">Bearer Token</option>
                  <option value="basic">Basic Auth</option>
                  <option value="apiKey">API Key Header</option>
                </select>
              </div>
              <div class="properties-section" id="prop-http-auth-bearer-section" style="display: none;">
                <label for="prop-http-auth-bearer">Bearer Token</label>
                <input type="text" id="prop-http-auth-bearer" placeholder="#{webhook.payload.token}">
              </div>
              <div id="prop-http-auth-basic-section" style="display: none;">
                <div class="properties-section">
                  <label for="prop-http-auth-user">Basic Username</label>
                  <input type="text" id="prop-http-auth-user" placeholder="api-user">
                </div>
                <div class="properties-section">
                  <label for="prop-http-auth-pass">Basic Password</label>
                  <input type="password" id="prop-http-auth-pass" placeholder="password or #{...}">
                </div>
              </div>
              <div id="prop-http-auth-apikey-section" style="display: none;">
                <div class="properties-section">
                  <label for="prop-http-auth-apikey-header">API Key Header Name</label>
                  <input type="text" id="prop-http-auth-apikey-header" placeholder="X-API-Key">
                </div>
                <div class="properties-section">
                  <label for="prop-http-auth-apikey-value">API Key Value</label>
                  <input type="password" id="prop-http-auth-apikey-value" placeholder="#{webhook.payload.apiKey}">
                </div>
              </div>
              <div class="properties-section">
                <label for="prop-http-headers">Headers (one per line: Header: Value)</label>
                <textarea id="prop-http-headers" placeholder="Accept: application/json&#10;Content-Type: application/json"></textarea>
              </div>
              <div class="properties-section">
                <label for="prop-http-body">Body (optional)</label>
                <textarea id="prop-http-body" placeholder='{"example": "value"}'></textarea>
              </div>
            </div>
          </div>
          
          <div id="prop-condition" style="display: none;">
            <div class="properties-section">
              <label for="prop-condition-source-alias">Source Node</label>
              <select id="prop-condition-source-alias">
                <option value="">Previous node (default)</option>
              </select>
            </div>
            <div class="properties-section">
              <label for="prop-condition-type">Test Type</label>
              <select id="prop-condition-type">
                <option value="return_code">Return Code</option>
                <option value="output_contains">Output Contains</option>
                <option value="regex_match">Regex Match</option>
                <option value="execution_time">Execution Time (seconds)</option>
                <option value="json_value">JSON Value</option>
              </select>
            </div>
            <div class="properties-section" id="prop-condition-path-section" style="display: none;">
              <label for="prop-condition-path">JSON Path</label>
              <input type="text" id="prop-condition-path" placeholder="e.g. result.count or items[0].status">
            </div>
            <div class="properties-section">
              <label for="prop-condition-operator">Operator</label>
              <select id="prop-condition-operator">
                <option value="==">== (equals)</option>
                <option value="!=">!= (not equals)</option>
                <option value="&gt;">&gt; (greater than)</option>
                <option value="!&gt;">!&gt; (not greater than)</option>
                <option value="&gt;=">&gt;= (greater or equal)</option>
                <option value="!>=">!&gt;= (not greater or equal)</option>
                <option value="&lt;">&lt; (less than)</option>
                <option value="!&lt;">!&lt; (not less than)</option>
                <option value="&lt;=">&lt;= (less or equal)</option>
                <option value="!&lt;=">!&lt;= (not less or equal)</option>
              </select>
              <small style="color: #999; margin-top: 5px; display: block;">For Output Contains, only equals/not equals are used</small>
            </div>
            <div class="properties-section">
              <label for="prop-condition-value">Value</label>
              <input type="text" id="prop-condition-value" placeholder="Enter value..." title="For regex, enter a valid regex pattern. For numeric, enter a number.">
            </div>
          </div>

          <div id="prop-split-join" style="display: none;">
            <div class="properties-section">
              <label for="prop-sj-mode">Mode</label>
              <select id="prop-sj-mode">
                <option value="split">Split (fan-out)</option>
                <option value="join">Join (merge paths)</option>
              </select>
            </div>
            <div class="properties-section" id="prop-sj-join-strategy-section">
              <label for="prop-sj-join-strategy">Join Strategy</label>
              <select id="prop-sj-join-strategy">
                <option value="waitAll">Wait For All</option>
                <option value="waitAny">Wait For First</option>
              </select>
            </div>
            <div class="properties-section" id="prop-sj-error-policy-section">
              <label for="prop-sj-error-policy">Error Policy</label>
              <select id="prop-sj-error-policy">
                <option value="waitForAll">Wait For All Paths</option>
                <option value="failFast">Fail Fast</option>
              </select>
            </div>
          </div>

          <div id="prop-wait" style="display: none;">
            <div class="properties-section">
              <label for="prop-wait-seconds">Delay (seconds)</label>
              <input type="number" id="prop-wait-seconds" min="0.1" step="0.1" placeholder="5">
            </div>
          </div>

          <div id="prop-notify" style="display: none;">
            <div class="properties-section">
              <label for="prop-notify-type">Notification Type</label>
              <select id="prop-notify-type">
                <option value="INFORMATION">Information</option>
                <option value="WARNING">Warning</option>
                <option value="ERROR">Error</option>
              </select>
            </div>
            <div class="properties-section">
              <label for="prop-notify-title">Title</label>
              <input type="text" id="prop-notify-title" placeholder="Orchestration Step Complete">
            </div>
            <div class="properties-section">
              <label for="prop-notify-body">Message</label>
              <textarea id="prop-notify-body" placeholder="Notification message (supports #{...} templates)"></textarea>
            </div>
            <div class="properties-section">
              <label for="prop-notify-url">Link (optional)</label>
              <input type="text" id="prop-notify-url" placeholder="/orchestration/monitor.html?...">
            </div>
          </div>
          
          <div id="prop-start" style="display: none; margin-bottom: 20px;">
            <label for="prop-start-terminate-on-error" style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12px; font-weight: 600; color: #666; text-transform: uppercase; margin-bottom: 8px;">
              <input type="checkbox" id="prop-start-terminate-on-error" style="all: revert; width: 14px; height: 14px; flex-shrink: 0; cursor: pointer; margin: 0; accent-color: #2196f3;">
              Terminate immediately on any step failure
            </label>
            <small style="color: #999; display: block; font-size: 11px; white-space: pre-wrap;">When checked, the orchestration stops as soon as any step returns a non-zero exit code.
When unchecked (default), execution continues through the graph to a Success or Failure end node.</small>
          </div>

          <div id="prop-end" style="display: none;">
            <div class="properties-section">
              <label>End Type</label>
              <div id="prop-end-type-display" style="padding: 8px; border-radius: 3px; color: #333; font-weight: 500;"></div>
            </div>
          </div>

          <div id="prop-plugin" style="display: none;">
            <div class="properties-section">
              <label>Plugin</label>
              <div id="prop-plugin-name-display" style="padding: 8px; border-radius: 3px; color: #333; font-weight: 500; font-family: monospace; font-size: 13px;"></div>
            </div>
            <div class="properties-section">
              <label for="prop-plugin-agent">Agent</label>
              <select id="prop-plugin-agent"></select>
            </div>
            <div class="properties-section">
              <label for="prop-plugin-timeout">Timeout (ms)</label>
              <input type="number" id="prop-plugin-timeout" min="1000" step="1000" placeholder="300000" title="Plugin execution timeout in milliseconds">
            </div>
            <div id="prop-plugin-fields"></div>
            <div id="prop-plugin-docs-section" style="display: none; margin-top: 12px;">
              <button id="prop-plugin-docs-btn" type="button" onclick="openPluginDocs()" style="width: 100%; padding: 8px 12px; background: #1565c0; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 6px;">
                <i class="material-icons" style="font-size: 16px; line-height: 1;">description</i>
                View Plugin Documentation
              </button>
            </div>
          </div>

          <button class="delete-btn" onclick="deleteSelectedNode()">Delete Node</button>
        </div>
      </div>
    </div>
  </div>
  
  <%- include('./partials/_footer'); %>
  
  <!-- Plugin Documentation Modal -->
  <div id="plugin-docs-modal" class="modal" style="max-height: 90vh; max-width: 860px; width: 92%;">
    <div class="modal-content" style="padding-bottom: 0;">
      <h4 id="plugin-docs-modal-title" style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
        <i class="material-icons" style="color: #1565c0;">description</i>
        <span></span>
      </h4>
    </div>
    <div style="padding: 0 24px 16px 24px; max-height: calc(90vh - 140px); overflow-y: auto;">
      <div id="plugin-docs-modal-body" style="line-height: 1.7; font-size: 14px; color: #333;"></div>
    </div>
    <div class="modal-footer">
      <a href="#!" class="modal-close waves-effect waves-blue btn-flat" style="color: #1565c0;">Close</a>
    </div>
  </div>

  <!-- Orchestration Naming Modal -->
  <div id="orchestration-naming-modal" class="modal">
    <div class="modal-content">
      <h4>Orchestration Name & Description</h4>
      <p>Provide a descriptive name for this orchestration to help identify it in history logs:</p>
      <div class="input-field" style="margin-top: 20px;">
        <input type="text" id="naming-modal-name" placeholder="e.g., Daily Backup Workflow">
        <label for="naming-modal-name">Orchestration Name *</label>
        <span class="helper-text" id="naming-helper-text" data-error=""></span>
      </div>
      <div class="input-field">
        <textarea id="naming-modal-desc" placeholder="Optional: Describe what this orchestration does" style="height: 80px; resize: vertical;"></textarea>
        <label for="naming-modal-desc">Description (Optional)</label>
      </div>
    </div>
    <div class="modal-footer">
      <a href="#!" class="modal-close waves-effect waves-green btn-flat">Cancel</a>
      <a href="#!" onclick="confirmOrchestrationName()" id="naming-confirm-button" class="waves-effect waves-green btn-flat" style="color: #4caf50; font-weight: 600;">Save & Continue</a>
    </div>
  </div>
  
  <!-- List Schedules Modal -->
  <div id="schedules-list-modal" class="modal" style="max-height: 90vh; max-width: 800px; width: 90%;">
    <div class="modal-content" style="max-height: 75vh; overflow-y: auto;">
      <h4><i class="material-icons" style="vertical-align: middle; margin-right: 10px;">list</i>Schedules Using This Orchestration</h4>
      <div id="schedules-list-container">
        <p style="text-align: center; color: var(--text-muted, #999);">Loading schedules...</p>
      </div>
    </div>
    <div class="modal-footer">
      <a href="#!" class="modal-close waves-effect waves-green btn-flat">Close</a>
    </div>
  </div>
  
  <!-- Execution Confirmation Modal -->
  <div id="execution-confirmation-modal" class="modal">
    <div class="modal-content">
      <h4>Execute Orchestration</h4>
      <p>Execute <strong id="exec-modal-name"></strong>?</p>
      <p style="font-size: 0.9em; color: var(--text-muted, #666); margin-top: 15px;">The orchestration will start immediately.</p>
    </div>
    <div class="modal-footer">
      <a href="#!" class="modal-close waves-effect waves-green btn-flat">Cancel</a>
      <a href="#!" onclick="proceedWithExecution()" class="waves-effect waves-red btn-flat" style="color: #f44336; font-weight: 600;">Execute</a>
    </div>
  </div>

  <!-- Delete Node Confirmation Modal -->
  <div id="delete-node-confirmation-modal" class="modal">
    <div class="modal-content">
      <h4><i class="material-icons" style="vertical-align: middle; margin-right: 8px; color: #f44336;">delete</i>Delete Node</h4>
      <p>Are you sure you want to delete this node?</p>
      <div style="background: #f5f5f5; padding: 12px; border-radius: 4px; margin: 15px 0; border-left: 4px solid #ff9800;">
        <div style="margin-bottom: 8px;">
          <span style="font-size: 0.85em; color: #666; text-transform: uppercase;">Node Type:</span>
          <strong id="delete-node-type" style="display: block; margin-top: 2px;"></strong>
        </div>
        <div style="margin-bottom: 8px;">
          <span style="font-size: 0.85em; color: #666; text-transform: uppercase;">Label:</span>
          <strong id="delete-node-label" style="display: block; margin-top: 2px;"></strong>
        </div>
        <div id="delete-node-extra-info"></div>
      </div>
    </div>
    <div class="modal-footer">
      <a href="#!" class="modal-close waves-effect waves-green btn-flat">Cancel</a>
      <a href="#!" onclick="confirmDeleteNode()" class="waves-effect waves-red btn-flat" style="color: #f44336; font-weight: 600;">Delete</a>
    </div>
  </div>

  <div id="orchestration-cancel-confirm-modal" class="modal modal-compact-confirm">
    <div class="modal-content">
      <h4>Discard Changes?</h4>
      <p>You have unsaved changes. Leaving now will discard them.</p>
    </div>
    <div class="modal-footer">
      <a href="#!" class="modal-close waves-effect waves-green btn-flat">Stay</a>
      <a href="#!" onclick="discardOrchestrationChanges()" class="waves-effect waves-red btn-flat" style="color: #f44336; font-weight: 600;">Discard &amp; Exit</a>
    </div>
  </div>

  <!-- Canvas Right-click Context Menu -->
  <div id="canvas-context-menu">
    <div class="ctx-menu-item ctx-danger" id="ctx-delete" onclick="ctxMenuDelete()">
      <i class="material-icons">delete</i> Delete
    </div>
    <div class="ctx-menu-item" id="ctx-clone" onclick="ctxMenuClone()">
      <i class="material-icons">content_copy</i> Clone
    </div>
    <div class="ctx-menu-separator"></div>
    <div class="ctx-menu-item" id="ctx-undo" onclick="ctxMenuUndo()">
      <i class="material-icons">undo</i> Undo
    </div>
    <div class="ctx-menu-item" id="ctx-redo" onclick="ctxMenuRedo()">
      <i class="material-icons">redo</i> Redo
    </div>
    <div class="ctx-menu-separator"></div>
    <div class="ctx-menu-item" onclick="ctxMenuZoomIn()">
      <i class="material-icons">zoom_in</i> Zoom In
    </div>
    <div class="ctx-menu-item" onclick="ctxMenuZoomOut()">
      <i class="material-icons">zoom_out</i> Zoom Out
    </div>
    <div class="ctx-menu-item" onclick="ctxMenuZoomReset()">
      <i class="material-icons">youtube_searched_for</i> Reset Zoom
    </div>
    <div class="ctx-menu-item" onclick="ctxMenuAutoLayout()">
      <i class="material-icons">auto_fix_high</i> Auto Layout
    </div>
  </div>

  <script>
    // SVG-based orchestration builder with labeled exit ports for conditions
    
    const CANVAS = {
      width: 1200,
      height: 800,
      minWidth: 1200,
      minHeight: 800,
      nodeWidth: 200,
      nodeHeight: 60,
      portRadius: 6,
      verticalSpacing: 75,
      expandPadding: 200,
      expandStep: 400
    };
    
    // Helper function to get CSS variable values with fallback
    function getCSSVariable(varName, fallback) {
      const value = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
      return value || fallback;
    }
    
    let svg = null;
    let edgeLayer = null;
    let nodeLayer = null;
    let selectedNode = null;
    let selectedNodes = new Set();
    let selectedEdge = null;
    let orchestrationId = '<%= jobId %>'.trim();
    if (!orchestrationId) orchestrationId = null;
    let availableScripts = [];
    let availableAgents = [];
    let availablePlugins = [];
    let orchestrationName = '';
    let orchestrationDescription = '';
    let orchestrationIcon = savedIcon;
    let orchestrationColor = savedColor;
    let pendingSave = false;
    let lastSavedOrchestrationState = '';
    let isLoadingOrchestration = false;
    let suppressUnsavedWarning = false;
    
    // Data structures
    let nodes = {};
    let edges = [];
    let nodeIdCounter = 0;
    let edgeIdCounter = 0;
    
    // State
    let isDraggingNode = null;
    let dragStartMouse = null;
    let dragStartNodePositions = null;
    let didDragMove = false;
    let isBoxSelecting = false;
    let boxSelectStart = null;
    let boxSelectRect = null;
    let suppressNextCanvasClick = false;
    let isDrawingEdge = false;
    let tempEdgeLine = null;
    let tempEdgeStartPort = null;
    let zoomLevel = 1;

    const MAX_HISTORY_ENTRIES = 100;
    let undoStack = [];
    let redoStack = [];
    let isApplyingHistoryState = false;
    let historyCommitTimer = null;

    function updateOrchestrationExportButtonState() {
      const exportButton = document.getElementById('export-button');
      if (!exportButton) return;

      const canExport = Boolean(orchestrationId);
      exportButton.disabled = !canExport;
      exportButton.title = canExport
        ? 'Export this orchestration'
        : 'Save this orchestration before exporting';
    }

    function exportCurrentOrchestration() {
      if (!orchestrationId) {
        M.toast({ html: 'Save this orchestration before exporting' });
        return;
      }

      window.location.href = '/rest/orchestration/jobs/' + encodeURIComponent(orchestrationId) + '/export';
    }
    
    $(document).ready(function() {
      console.log('Orchestra Builder loaded, orchestrationId:', orchestrationId);
      // Initialize Materialize modal
      $('.modal').modal();
      initializeSVG();
      loadScripts();
      loadAgents();
      loadPlugins();
      if (orchestrationId) {
        isLoadingOrchestration = true;
        console.log('Loading existing orchestration:', orchestrationId);
        loadOrchestration();
      } else {
        console.log('New orchestration - no ID specified');
      }
      setupDragAndDrop();
      setupZoomControls();

      const propsContent = document.getElementById('properties-content');
      if (propsContent) {
        propsContent.addEventListener('input', () => scheduleHistoryCommit(350));
        propsContent.addEventListener('change', () => scheduleHistoryCommit(120));
      }

      if (!orchestrationId) {
        resetHistoryFromCurrentState();
        markOrchestrationSavedState();
      }
      updateOrchestrationExportButtonState();

      // Initialize color picker for both new and existing orchestrations
      setColorPicker(savedColor);
      // Setup name display click handler
      document.getElementById('orch-name-display').addEventListener('click', enterNameEditMode);
      
      // Setup theme change listener to re-render nodes when theme toggles
      const stylesheetLink = document.getElementById('maincss');
      if (stylesheetLink) {
        const observer = new MutationObserver(() => {
          // Add a small delay to ensure CSS variables are updated
          setTimeout(() => {
            if (Object.keys(nodes).length > 0) {
              renderAllNodes();
              renderAllEdges();
            }
          }, 50);
        });
        observer.observe(stylesheetLink, { attributes: true, attributeFilter: ['href'] });
      }

      window.addEventListener('beforeunload', function(e) {
        if (suppressUnsavedWarning || !hasUnsavedOrchestrationChanges()) return;
        e.preventDefault();
        e.returnValue = '';
      });
    });
    
    function initializeSVG() {
      svg = document.getElementById('orchestration-svg');
      svg.setAttribute('width', CANVAS.width);
      svg.setAttribute('height', CANVAS.height);
      svg.setAttribute('viewBox', `0 0 ${CANVAS.width} ${CANVAS.height}`);
      svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      
      // Get or create layers
      let edgeLyr = svg.querySelector('#edge-layer');
      if (!edgeLyr) {
        edgeLyr = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        edgeLyr.setAttribute('id', 'edge-layer');
        svg.appendChild(edgeLyr);
      }
      edgeLayer = edgeLyr;
      
      let nodeLyr = svg.querySelector('#node-layer');
      if (!nodeLyr) {
        nodeLyr = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        nodeLyr.setAttribute('id', 'node-layer');
        svg.appendChild(nodeLyr);
      }
      nodeLayer = nodeLyr;
      
      // Add canvas interaction
      svg.addEventListener('mousedown', onSVGMouseDown);
      svg.addEventListener('click', onSVGClick);
      svg.addEventListener('mousemove', onSVGMouseMove);
      svg.addEventListener('mouseup', onSVGMouseUp);
      svg.addEventListener('contextmenu', onSVGContextMenu);

      // Hide context menu on any click or new contextmenu elsewhere
      document.addEventListener('click', hideContextMenu);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') hideContextMenu();
      });
    }

    function getCanvasPointFromEvent(e) {
      const rect = svg.getBoundingClientRect();
      return {
        x: ((e.clientX - rect.left) / rect.width) * CANVAS.width,
        y: ((e.clientY - rect.top) / rect.height) * CANVAS.height
      };
    }

    function getNodeBounds(node) {
      const isCircularNode = node.type === 'start' || node.type === 'end-success' || node.type === 'end-failure';
      const isDiamondNode = node.type === 'condition' || node.type === 'split-join';

      if (isCircularNode || isDiamondNode) {
        return {
          left: node.x - 28,
          right: node.x + 28,
          top: node.y - 28,
          bottom: node.y + 28
        };
      }

      const dim = getNodeDimensions(node);
      return {
        left: node.x - (dim.width / 2),
        right: node.x + (dim.width / 2),
        top: node.y - (CANVAS.nodeHeight / 2),
        bottom: node.y + (CANVAS.nodeHeight / 2)
      };
    }

    function createGraphStateSnapshot() {
      return {
        nodes: JSON.parse(JSON.stringify(nodes)),
        edges: JSON.parse(JSON.stringify(edges)),
        nodeIdCounter,
        edgeIdCounter
      };
    }

    function serializeGraphState(state) {
      const nodeIds = Object.keys(state.nodes || {}).sort();
      const sortedNodes = {};
      nodeIds.forEach(id => {
        sortedNodes[id] = state.nodes[id];
      });

      const sortedEdges = (state.edges || []).slice().sort((a, b) => {
        const aId = a.id || '';
        const bId = b.id || '';
        if (aId && bId && aId !== bId) return aId.localeCompare(bId);
        if ((a.from || '') !== (b.from || '')) return (a.from || '').localeCompare(b.from || '');
        if ((a.to || '') !== (b.to || '')) return (a.to || '').localeCompare(b.to || '');
        return (a.fromPort || '').localeCompare(b.fromPort || '');
      });

      return JSON.stringify({
        nodes: sortedNodes,
        edges: sortedEdges,
        nodeIdCounter: state.nodeIdCounter || 0,
        edgeIdCounter: state.edgeIdCounter || 0
      });
    }

    function graphStatesEqual(a, b) {
      if (!a || !b) return false;
      return serializeGraphState(a) === serializeGraphState(b);
    }

    function getOrchestrationStateSignature() {
      return JSON.stringify({
        graph: serializeGraphState(createGraphStateSnapshot()),
        name: orchestrationName || '',
        description: orchestrationDescription || '',
        icon: orchestrationIcon || '',
        color: orchestrationColor || ''
      });
    }

    function markOrchestrationSavedState() {
      lastSavedOrchestrationState = getOrchestrationStateSignature();
    }

    function hasUnsavedOrchestrationChanges() {
      if (isLoadingOrchestration) return false;
      if (!lastSavedOrchestrationState) return false;
      return getOrchestrationStateSignature() !== lastSavedOrchestrationState;
    }

    function promptDiscardOrchestrationChanges() {
      const modalElement = document.getElementById('orchestration-cancel-confirm-modal');
      if (!modalElement) {
        discardOrchestrationChanges();
        return;
      }
      const modal = M.Modal.getInstance(modalElement) || M.Modal.init(modalElement);
      modal.open();
    }

    function cancelOrchestrationChanges() {
      if (!hasUnsavedOrchestrationChanges()) {
        window.location.href = '/orchestrationList.html';
        return;
      }
      promptDiscardOrchestrationChanges();
    }

    function discardOrchestrationChanges() {
      suppressUnsavedWarning = true;
      window.location.href = '/orchestrationList.html';
    }

    function updateUndoRedoButtons() {
      const undoButton = document.getElementById('undo-button');
      const redoButton = document.getElementById('redo-button');
      if (undoButton) undoButton.disabled = undoStack.length <= 1;
      if (redoButton) redoButton.disabled = redoStack.length === 0;
    }

    function applyGraphState(state) {
      if (!state) return;
      isApplyingHistoryState = true;

      nodes = JSON.parse(JSON.stringify(state.nodes || {}));
      edges = JSON.parse(JSON.stringify(state.edges || []));
      nodeIdCounter = state.nodeIdCounter || 0;
      edgeIdCounter = state.edgeIdCounter || 0;

      Object.keys(nodes).forEach(id => {
        ensureExecuteDefaults(nodes[id]);
        ensureWaitDefaults(nodes[id]);
        ensureNotifyDefaults(nodes[id]);
      });

      selectedNode = null;
      selectedNodes.clear();
      selectedEdge = null;
      updatePropertiesPanel();
      renderAllNodes();
      shrinkCanvasToFitNodes();
      expandCanvasForAllNodes();
      updateStats();
      updateUndoRedoButtons();

      isApplyingHistoryState = false;
    }

    function resetHistoryFromCurrentState() {
      const snapshot = createGraphStateSnapshot();
      undoStack = [snapshot];
      redoStack = [];
      if (historyCommitTimer) {
        clearTimeout(historyCommitTimer);
        historyCommitTimer = null;
      }
      updateUndoRedoButtons();
    }

    function commitHistorySnapshot() {
      if (isApplyingHistoryState) return;
      const snapshot = createGraphStateSnapshot();
      const previousSnapshot = undoStack.length ? undoStack[undoStack.length - 1] : null;
      if (previousSnapshot && graphStatesEqual(previousSnapshot, snapshot)) return;

      undoStack.push(snapshot);
      if (undoStack.length > MAX_HISTORY_ENTRIES) {
        undoStack.shift();
      }
      redoStack = [];
      updateUndoRedoButtons();
    }

    function scheduleHistoryCommit(delayMs = 250) {
      if (isApplyingHistoryState) return;
      if (historyCommitTimer) clearTimeout(historyCommitTimer);
      historyCommitTimer = setTimeout(() => {
        historyCommitTimer = null;
        commitHistorySnapshot();
      }, delayMs);
    }

    function undoGraphChange() {
      if (undoStack.length <= 1) return false;
      if (historyCommitTimer) {
        clearTimeout(historyCommitTimer);
        historyCommitTimer = null;
      }

      const current = undoStack.pop();
      redoStack.push(current);
      const previous = undoStack[undoStack.length - 1];
      applyGraphState(previous);
      return true;
    }

    function redoGraphChange() {
      if (redoStack.length === 0) return false;
      if (historyCommitTimer) {
        clearTimeout(historyCommitTimer);
        historyCommitTimer = null;
      }

      const next = redoStack.pop();
      undoStack.push(next);
      applyGraphState(next);
      return true;
    }

    function finalizeBoxSelection() {
      if (!boxSelectStart) {
        isBoxSelecting = false;
        if (boxSelectRect) boxSelectRect.remove();
        boxSelectRect = null;
        return;
      }

      const startX = boxSelectStart.x;
      const startY = boxSelectStart.y;
      const endX = boxSelectStart.currentX;
      const endY = boxSelectStart.currentY;
      const minX = Math.min(startX, endX);
      const maxX = Math.max(startX, endX);
      const minY = Math.min(startY, endY);
      const maxY = Math.max(startY, endY);
      const movedFarEnough = Math.abs(endX - startX) > 4 || Math.abs(endY - startY) > 4;

      if (movedFarEnough) {
        const nextSelection = boxSelectStart.additive ? new Set(selectedNodes) : new Set();

        Object.keys(nodes).forEach(nodeId => {
          const node = nodes[nodeId];
          const bounds = getNodeBounds(node);
          const intersects = !(
            bounds.right < minX ||
            bounds.left > maxX ||
            bounds.bottom < minY ||
            bounds.top > maxY
          );

          if (intersects) nextSelection.add(nodeId);
        });

        selectedNodes = nextSelection;
        selectedNode = selectedNodes.size ? Array.from(selectedNodes)[selectedNodes.size - 1] : null;
        selectedEdge = null;
        suppressNextCanvasClick = true;
        updatePropertiesPanel();
        renderAllNodes();
      }

      isBoxSelecting = false;
      boxSelectStart = null;
      if (boxSelectRect) boxSelectRect.remove();
      boxSelectRect = null;
    }

    function onSVGMouseDown(e) {
      const isCanvasBackground = e.target === svg || (e.target.tagName === 'g' && !e.target.hasAttribute('data-node-id'));
      if (!isCanvasBackground || isDrawingEdge) return;

      const point = getCanvasPointFromEvent(e);
      isBoxSelecting = true;
      boxSelectStart = {
        x: point.x,
        y: point.y,
        currentX: point.x,
        currentY: point.y,
        additive: Boolean(e.ctrlKey || e.metaKey)
      };

      if (boxSelectRect) boxSelectRect.remove();
      boxSelectRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      boxSelectRect.setAttribute('x', point.x);
      boxSelectRect.setAttribute('y', point.y);
      boxSelectRect.setAttribute('width', 0);
      boxSelectRect.setAttribute('height', 0);
      boxSelectRect.setAttribute('fill', getCSSVariable('--primary-color', '#2196f3'));
      boxSelectRect.setAttribute('fill-opacity', '0.08');
      boxSelectRect.setAttribute('stroke', getCSSVariable('--primary-color', '#2196f3'));
      boxSelectRect.setAttribute('stroke-width', '1');
      boxSelectRect.setAttribute('stroke-dasharray', '4,3');
      boxSelectRect.setAttribute('pointer-events', 'none');
      svg.appendChild(boxSelectRect);
    }

    function roundUpToStep(value, step) {
      return Math.ceil(value / step) * step;
    }

    function updateCanvasSizeIfNeeded(targetWidth, targetHeight) {
      const nextWidth = Math.max(CANVAS.minWidth, targetWidth);
      const nextHeight = Math.max(CANVAS.minHeight, targetHeight);
      if (nextWidth <= CANVAS.width && nextHeight <= CANVAS.height) return;

      CANVAS.width = Math.max(CANVAS.width, nextWidth);
      CANVAS.height = Math.max(CANVAS.height, nextHeight);
      svg.setAttribute('width', CANVAS.width);
      svg.setAttribute('height', CANVAS.height);
      svg.setAttribute('viewBox', `0 0 ${CANVAS.width} ${CANVAS.height}`);
    }

    function shrinkCanvasToFitNodes() {
      let maxRight = 0;
      let maxBottom = 0;

      nodeLayer.querySelectorAll('[data-node-id]').forEach(nodeGroup => {
        const bounds = nodeGroup.getBBox();
        maxRight = Math.max(maxRight, bounds.x + bounds.width);
        maxBottom = Math.max(maxBottom, bounds.y + bounds.height);
      });

      if (maxRight === 0 && maxBottom === 0) {
        CANVAS.width = CANVAS.minWidth;
        CANVAS.height = CANVAS.minHeight;
        svg.setAttribute('width', CANVAS.width);
        svg.setAttribute('height', CANVAS.height);
        svg.setAttribute('viewBox', `0 0 ${CANVAS.width} ${CANVAS.height}`);
        return;
      }

      const horizontalDropRoom = CANVAS.nodeWidth + 120;
      const verticalDropRoom = CANVAS.nodeHeight + CANVAS.verticalSpacing;
      const rightPadding = Math.max(CANVAS.expandPadding, horizontalDropRoom);
      const bottomPadding = Math.max(CANVAS.expandPadding, verticalDropRoom);

      const targetWidth = Math.max(
        CANVAS.minWidth,
        roundUpToStep(maxRight + rightPadding, CANVAS.expandStep)
      );
      const targetHeight = Math.max(
        CANVAS.minHeight,
        roundUpToStep(maxBottom + bottomPadding, CANVAS.expandStep)
      );

      if (targetWidth >= CANVAS.width && targetHeight >= CANVAS.height) return;

      CANVAS.width = Math.min(CANVAS.width, targetWidth);
      CANVAS.height = Math.min(CANVAS.height, targetHeight);
      svg.setAttribute('width', CANVAS.width);
      svg.setAttribute('height', CANVAS.height);
      svg.setAttribute('viewBox', `0 0 ${CANVAS.width} ${CANVAS.height}`);
    }

    function expandCanvasForNode(nodeId) {
      if (!nodeLayer) return;
      const nodeGroup = nodeLayer.querySelector(`[data-node-id="${nodeId}"]`);
      if (!nodeGroup) return;

      const bounds = nodeGroup.getBBox();
      const requiredWidth = bounds.x + bounds.width + CANVAS.expandPadding;
      const requiredHeight = bounds.y + bounds.height + CANVAS.expandPadding;

      const targetWidth = requiredWidth > CANVAS.width
        ? roundUpToStep(requiredWidth, CANVAS.expandStep)
        : CANVAS.width;
      const targetHeight = requiredHeight > CANVAS.height
        ? roundUpToStep(requiredHeight, CANVAS.expandStep)
        : CANVAS.height;

      updateCanvasSizeIfNeeded(targetWidth, targetHeight);
    }

    function expandCanvasForAllNodes() {
      let maxRight = 0;
      let maxBottom = 0;

      nodeLayer.querySelectorAll('[data-node-id]').forEach(nodeGroup => {
        const bounds = nodeGroup.getBBox();
        maxRight = Math.max(maxRight, bounds.x + bounds.width);
        maxBottom = Math.max(maxBottom, bounds.y + bounds.height);
      });

      if (maxRight === 0 && maxBottom === 0) return;

      const targetWidth = roundUpToStep(maxRight + CANVAS.expandPadding, CANVAS.expandStep);
      const targetHeight = roundUpToStep(maxBottom + CANVAS.expandPadding, CANVAS.expandStep);
      updateCanvasSizeIfNeeded(targetWidth, targetHeight);
    }
    
    function setupDragAndDrop() {
      const paletteItems = document.querySelectorAll('.palette-item');
      
      paletteItems.forEach(item => {
        item.addEventListener('dragstart', function(e) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('nodeType', this.dataset.nodeType);
          
          // Create custom drag image for condition nodes to show diamond shape
          if (this.dataset.nodeType === 'condition' || this.dataset.nodeType === 'split-join') {
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('width', '40');
            svg.setAttribute('height', '40');
            svg.setAttribute('viewBox', '0 0 40 40');
            
            const polygon = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
            polygon.setAttribute('points', '20,0 40,20 20,40 0,20');
            polygon.setAttribute('fill', '#f9f9f9');
            polygon.setAttribute('stroke', '#e0e0e0');
            polygon.setAttribute('stroke-width', '1');
            
            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('x', '20');
            text.setAttribute('y', '21');
            text.setAttribute('font-family', 'Arial, sans-serif');
            text.setAttribute('font-size', '10');
            text.setAttribute('font-weight', 'bold');
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('dominant-baseline', 'middle');
            text.setAttribute('fill', '#333');
            if (this.dataset.nodeType === 'condition') {
              text.textContent = 'if';
            } else {
              const tspan1 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan');
              tspan1.setAttribute('x', '20');
              tspan1.setAttribute('dy', '-3');
              tspan1.textContent = 'Split';
              const tspan2 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan');
              tspan2.setAttribute('x', '20');
              tspan2.setAttribute('dy', '10');
              tspan2.textContent = 'Join';
              text.appendChild(tspan1);
              text.appendChild(tspan2);
            }
            
            svg.appendChild(polygon);
            svg.appendChild(text);
            
            // Create a temporary container
            const container = document.createElement('div');
            container.style.position = 'absolute';
            container.style.top = '-9999px';
            container.appendChild(svg);
            document.body.appendChild(container);
            
            e.dataTransfer.setDragImage(svg, 20, 20);
            
            // Clean up after drag
            setTimeout(() => document.body.removeChild(container), 0);
          }
        });
      });
      
      const canvas = document.getElementById('orchestration-canvas');
      canvas.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
      });
      
      canvas.addEventListener('drop', function(e) {
        e.preventDefault();
        const nodeType = e.dataTransfer.getData('nodeType');
        
        // Check if trying to add more than one start node
        if (nodeType === 'start') {
          const existingStartNode = Object.values(nodes).find(n => n.type === 'start');
          if (existingStartNode) {
            alert('Only one Start node is allowed per orchestration');
            return;
          }
        }
        
        // Calculate SVG coordinates from canvas event
        const rect = svg.getBoundingClientRect();
        const svgX = ((e.clientX - rect.left) / rect.width) * CANVAS.width;
        const svgY = ((e.clientY - rect.top) / rect.height) * CANVAS.height;

        const pluginName = e.dataTransfer.getData('plugin-name');
        if (pluginName) {
          createNode('plugin', svgX, svgY, { pluginName });
        } else {
          createNode(nodeType, svgX, svgY);
        }
      });
    }
    
    function setupZoomControls() {
      document.getElementById('zoom-in').addEventListener('click', function() {
        zoomLevel = Math.min(zoomLevel + 0.1, 3);
        applyZoom();
      });
      
      document.getElementById('zoom-out').addEventListener('click', function() {
        zoomLevel = Math.max(zoomLevel - 0.1, 0.5);
        applyZoom();
      });
      
      document.getElementById('zoom-reset').addEventListener('click', function() {
        zoomLevel = 1;
        applyZoom();
      });

      document.getElementById('zoom-auto-layout').addEventListener('click', function() {
        autoLayoutOrchestration();
      });
    }
    
    function applyZoom() {
      svg.style.transform = `scale(${zoomLevel})`;
      svg.style.transformOrigin = '0 0';
      document.getElementById('zoom-level').textContent = Math.round(zoomLevel * 100) + '%';
    }

    function getNodeDimensions(node) {
      const isStartNode = node.type === 'start';
      const isEndNode = node.type === 'end-success' || node.type === 'end-failure';
      const isDiamondNode = node.type === 'condition' || node.type === 'split-join';

      if (isStartNode || isEndNode || isDiamondNode) {
        return { width: 56, height: 56 };
      }

      const tempText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      tempText.setAttribute('font-family', 'Arial, sans-serif');
      tempText.setAttribute('font-size', '14');
      tempText.setAttribute('font-weight', '500');
      tempText.textContent = node.label || 'Node';
      nodeLayer.appendChild(tempText);
      const textWidth = tempText.getComputedTextLength();
      nodeLayer.removeChild(tempText);

      return {
        width: Math.max(200, 18 + 8 + textWidth + 16),
        height: CANVAS.nodeHeight
      };
    }

    function normalizeAutoLayoutBounds(nodeIds, nodeDims) {
      const minPadding = Math.max(60, Math.floor(CANVAS.expandPadding / 2));
      let minLeft = Number.POSITIVE_INFINITY;
      let minTop = Number.POSITIVE_INFINITY;
      let maxRight = Number.NEGATIVE_INFINITY;
      let maxBottom = Number.NEGATIVE_INFINITY;

      nodeIds.forEach(id => {
        const node = nodes[id];
        if (!node) return;

        const dim = nodeDims[id] || getNodeDimensions(node);
        const left = node.x - (dim.width / 2);
        const top = node.y - (dim.height / 2);
        const right = node.x + (dim.width / 2);
        const bottom = node.y + (dim.height / 2);

        minLeft = Math.min(minLeft, left);
        minTop = Math.min(minTop, top);
        maxRight = Math.max(maxRight, right);
        maxBottom = Math.max(maxBottom, bottom);
      });

      if (!Number.isFinite(minLeft) || !Number.isFinite(minTop)) return;

      const shiftX = minLeft < minPadding ? (minPadding - minLeft) : 0;
      const shiftY = minTop < minPadding ? (minPadding - minTop) : 0;

      if (shiftX || shiftY) {
        nodeIds.forEach(id => {
          if (!nodes[id]) return;
          nodes[id].x += shiftX;
          nodes[id].y += shiftY;
        });
        maxRight += shiftX;
        maxBottom += shiftY;
      }

      const targetWidth = roundUpToStep(
        maxRight + Math.max(CANVAS.expandPadding, minPadding),
        CANVAS.expandStep
      );
      const targetHeight = roundUpToStep(
        maxBottom + Math.max(CANVAS.expandPadding, minPadding),
        CANVAS.expandStep
      );
      updateCanvasSizeIfNeeded(targetWidth, targetHeight);
    }

    function autoLayoutOrchestration() {
      const nodeIds = Object.keys(nodes);
      if (!nodeIds.length) return;

      const incoming = {};
      const incomingEdgeMeta = {};
      const outgoing = {};
      const indegree = {};
      const depth = {};
      const nodeDims = {};

      nodeIds.forEach(id => {
        incoming[id] = [];
        incomingEdgeMeta[id] = [];
        outgoing[id] = [];
        indegree[id] = 0;
        depth[id] = 0;
        nodeDims[id] = getNodeDimensions(nodes[id]);
      });

      edges.forEach(edge => {
        if (!nodes[edge.from] || !nodes[edge.to]) return;
        outgoing[edge.from].push(edge.to);
        incoming[edge.to].push(edge.from);
        incomingEdgeMeta[edge.to].push({
          parentId: edge.from,
          fromPort: edge.fromPort
        });
        indegree[edge.to] += 1;
      });

      const queue = nodeIds.filter(id => indegree[id] === 0);
      const indegreeWork = { ...indegree };
      const topo = [];

      while (queue.length) {
        const current = queue.shift();
        topo.push(current);
        outgoing[current].forEach(next => {
          depth[next] = Math.max(depth[next], depth[current] + 1);
          indegreeWork[next] -= 1;
          if (indegreeWork[next] === 0) queue.push(next);
        });
      }

      // Handle cyclic subgraphs by appending remaining nodes and placing them after their deepest parent.
      const remaining = nodeIds.filter(id => !topo.includes(id));
      remaining.forEach(id => {
        const parentDepths = incoming[id].map(parentId => depth[parentId] || 0);
        depth[id] = parentDepths.length ? Math.max(...parentDepths) + 1 : 0;
        topo.push(id);
      });

      const layers = {};
      topo.forEach(id => {
        const layerId = depth[id] || 0;
        if (!layers[layerId]) layers[layerId] = [];
        layers[layerId].push(id);
      });

      const layerIds = Object.keys(layers).map(v => parseInt(v, 10)).sort((a, b) => a - b);
      const rankByLayer = {};

      function getConditionBranchBias(parentId, fromPort) {
        const parentNode = nodes[parentId];
        if (!parentNode || parentNode.type !== 'condition') return 0;
        if (fromPort === 'true') return -0.35;
        if (fromPort === 'false') return 0.35;
        return 0;
      }

      function getNodeOrderScore(nodeId, prevRank) {
        const parentEdges = incomingEdgeMeta[nodeId] || [];
        if (!parentEdges.length) return Number.MAX_SAFE_INTEGER;

        const weightedScore = parentEdges.reduce((sum, edgeMeta) => {
          const parentRank = prevRank[edgeMeta.parentId] ?? 0;
          return sum + parentRank + getConditionBranchBias(edgeMeta.parentId, edgeMeta.fromPort);
        }, 0);

        return weightedScore / parentEdges.length;
      }

      // One forward barycenter pass for better readability and fewer edge crossings.
      layerIds.forEach((layerId, idx) => {
        if (idx === 0) {
          rankByLayer[layerId] = {};
          layers[layerId].forEach((id, rank) => {
            rankByLayer[layerId][id] = rank;
          });
          return;
        }

        const prevLayerId = layerIds[idx - 1];
        const prevRank = rankByLayer[prevLayerId] || {};

        layers[layerId].sort((a, b) => {
          const aScore = getNodeOrderScore(a, prevRank);
          const bScore = getNodeOrderScore(b, prevRank);
          if (aScore !== bScore) return aScore - bScore;

          // Keep relative stability between reruns when scores are equal.
          return (nodes[a].x || 0) - (nodes[b].x || 0);
        });

        rankByLayer[layerId] = {};
        layers[layerId].forEach((id, rank) => {
          rankByLayer[layerId][id] = rank;
        });
      });

      const horizontalGap = 110;
      const verticalGap = 105;
      const topPadding = 120;
      const sidePadding = 120;

      const maxLayerWidth = Math.max(...layerIds.map(layerId => {
        const ids = layers[layerId];
        const widthSum = ids.reduce((sum, id) => sum + nodeDims[id].width, 0);
        return widthSum + Math.max(0, ids.length - 1) * horizontalGap;
      }));

      layerIds.forEach(layerId => {
        const ids = layers[layerId];
        const widthSum = ids.reduce((sum, id) => sum + nodeDims[id].width, 0);
        const layerWidth = widthSum + Math.max(0, ids.length - 1) * horizontalGap;
        let cursorX = sidePadding + (maxLayerWidth - layerWidth) / 2;

        ids.forEach(id => {
          const dim = nodeDims[id];
          nodes[id].x = cursorX + dim.width / 2;
          nodes[id].y = topPadding + (layerId * verticalGap);
          cursorX += dim.width + horizontalGap;
        });
      });

      // Second pass: move each node toward the average X position of its parents,
      // while preserving non-overlap within the layer.
      layerIds.forEach((layerId, idx) => {
        if (idx === 0) return;

        const ids = layers[layerId];
        if (!ids || ids.length === 0) return;

        ids.sort((a, b) => (nodes[a].x || 0) - (nodes[b].x || 0));

        const desiredCenters = {};
        ids.forEach(id => {
          const parentIds = incoming[id] || [];
          if (!parentIds.length) {
            desiredCenters[id] = nodes[id].x;
            return;
          }

          const parentCenter = parentIds.reduce((sum, parentId) => sum + (nodes[parentId]?.x || 0), 0) / parentIds.length;
          desiredCenters[id] = parentCenter;
        });

        for (let i = 0; i < ids.length; i++) {
          const id = ids[i];
          const dim = nodeDims[id];
          let targetX = desiredCenters[id];

          if (i > 0) {
            const prevId = ids[i - 1];
            const prevDim = nodeDims[prevId];
            const minX = nodes[prevId].x + (prevDim.width / 2) + (dim.width / 2) + horizontalGap;
            targetX = Math.max(targetX, minX);
          }

          nodes[id].x = targetX;
        }

        for (let i = ids.length - 2; i >= 0; i--) {
          const id = ids[i];
          const nextId = ids[i + 1];
          const dim = nodeDims[id];
          const nextDim = nodeDims[nextId];
          const maxX = nodes[nextId].x - (nextDim.width / 2) - (dim.width / 2) - horizontalGap;
          nodes[id].x = Math.min(nodes[id].x, maxX);
        }
      });

      // Keep true/false branch semantics while widening branches based on downstream subtree size.
      const nextNodeByPort = {};
      edges.forEach(edge => {
        if (!nextNodeByPort[edge.from]) nextNodeByPort[edge.from] = {};
        nextNodeByPort[edge.from][edge.fromPort] = edge.to;
      });

      function collectReachableNodeIds(startId) {
        const visited = new Set();
        const stack = [startId];

        while (stack.length) {
          const currentId = stack.pop();
          if (!currentId || visited.has(currentId) || !nodes[currentId]) continue;
          visited.add(currentId);
          (outgoing[currentId] || []).forEach(nextId => {
            if (!visited.has(nextId)) stack.push(nextId);
          });
        }

        return visited;
      }

      function shiftNodeSetX(nodeIdSet, deltaX) {
        if (!deltaX) return;
        nodeIdSet.forEach(id => {
          if (nodes[id]) nodes[id].x += deltaX;
        });
      }

      topo.forEach(nodeId => {
        const node = nodes[nodeId];
        if (!node || node.type !== 'condition') return;

        const trueTargetId = nextNodeByPort[nodeId]?.true;
        const falseTargetId = nextNodeByPort[nodeId]?.false;
        if (!trueTargetId || !falseTargetId) return;
        if (!nodes[trueTargetId] || !nodes[falseTargetId]) return;
        if (trueTargetId === falseTargetId) return;

        const trueReachable = collectReachableNodeIds(trueTargetId);
        const falseReachable = collectReachableNodeIds(falseTargetId);

        const sharedReachable = new Set();
        trueReachable.forEach(id => {
          if (falseReachable.has(id)) sharedReachable.add(id);
        });

        const trueExclusive = new Set([...trueReachable].filter(id => !sharedReachable.has(id)));
        const falseExclusive = new Set([...falseReachable].filter(id => !sharedReachable.has(id)));

        if (!trueExclusive.size) trueExclusive.add(trueTargetId);
        if (!falseExclusive.size) falseExclusive.add(falseTargetId);

        if (nodes[trueTargetId].x > nodes[falseTargetId].x) {
          const leftDelta = nodes[falseTargetId].x - nodes[trueTargetId].x;
          const rightDelta = nodes[trueTargetId].x - nodes[falseTargetId].x;
          shiftNodeSetX(trueExclusive, leftDelta);
          shiftNodeSetX(falseExclusive, rightDelta);
        }

        const trueWeight = Math.max(1, trueExclusive.size);
        const falseWeight = Math.max(1, falseExclusive.size);
        const minSpread = 220;
        const dynamicSpread = Math.min(760, minSpread + ((trueWeight + falseWeight - 2) * 24));
        const desiredSpread = Math.max(minSpread, dynamicSpread);

        const currentSpread = nodes[falseTargetId].x - nodes[trueTargetId].x;
        if (currentSpread < desiredSpread) {
          const additionalSpread = desiredSpread - currentSpread;
          const totalWeight = trueWeight + falseWeight;
          const trueShift = (additionalSpread * falseWeight) / totalWeight;
          const falseShift = (additionalSpread * trueWeight) / totalWeight;

          shiftNodeSetX(trueExclusive, -trueShift);
          shiftNodeSetX(falseExclusive, falseShift);
        }

        // Re-center branch targets around the condition node for a cleaner fan-out shape.
        const midPoint = (nodes[trueTargetId].x + nodes[falseTargetId].x) / 2;
        const targetMidPoint = nodes[nodeId].x;
        const reCenterDelta = targetMidPoint - midPoint;

        shiftNodeSetX(trueExclusive, reCenterDelta);
        shiftNodeSetX(falseExclusive, reCenterDelta);

        // Ensure spread remains positive after recentering.
        if (nodes[falseTargetId].x <= nodes[trueTargetId].x) {
          const correction = ((nodes[trueTargetId].x - nodes[falseTargetId].x) + 30) / 2;
          shiftNodeSetX(trueExclusive, -correction);
          shiftNodeSetX(falseExclusive, correction);
        }
      });

      normalizeAutoLayoutBounds(nodeIds, nodeDims);

      renderAllNodes();
      shrinkCanvasToFitNodes();
      expandCanvasForAllNodes();
      renderAllEdges();
      commitHistorySnapshot();
      M.toast({ html: 'Auto layout applied' });
    }
    
    // Helper function to get dynamic port position accounting for variable node width and circular nodes
    function getPortPosition(node, portId) {
      const port = node.ports.find(p => p.id === portId);
      if (!port) return null;
      
      const isCircularNode = node.type === 'start' || node.type === 'end-success' || node.type === 'end-failure';
      const isConditionNode = node.type === 'condition';
      const isSplitJoinNode = node.type === 'split-join';
      
      if (isCircularNode && node.type === 'start') {
        // For circular start nodes, port is at bottom center on the circle edge
        return {
          x: node.x,
          y: node.y + 28 // circle radius
        };
      }
      
      // Measure label width to calculate dynamic box width for rectangular nodes
      const tempText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      tempText.setAttribute('font-family', 'Arial, sans-serif');
      tempText.setAttribute('font-size', '14');
      tempText.setAttribute('font-weight', '500');
      tempText.textContent = node.label;
      nodeLayer.appendChild(tempText);
      const textWidth = tempText.getComputedTextLength();
      nodeLayer.removeChild(tempText);
      
      const minWidth = 200;
      const nodeWidth = Math.max(minWidth, 18 + 8 + textWidth + 16);
      
      // Calculate dynamic port x position
      let portX = port.x;
      if (node.type === 'execute' || node.type === 'wait' || node.type === 'notify') {
        portX = nodeWidth / 2;
      } else if (isConditionNode || isSplitJoinNode) {
        // For diamond nodes, ports are already positioned relative to center
        return {
          x: node.x + port.x,
          y: node.y + port.y
        };
      }
      
      return {
        x: node.x + portX - nodeWidth / 2,
        y: node.y + port.y - CANVAS.nodeHeight / 2
      };
    }

    function getSplitJoinPorts(mode) {
      if (mode === 'join') {
        return [{ id: 'out', label: 'next', x: 0, y: 32 }];
      }
      return [{ id: 'out', label: 'paths', x: 0, y: 32 }];
    }

    function headersToMultiline(headers) {
      if (!Array.isArray(headers)) return '';
      return headers
        .filter(h => h && h.key)
        .map(h => `${h.key}: ${h.value || ''}`)
        .join('\n');
    }

    function parseHeadersMultiline(rawHeaders) {
      if (!rawHeaders || typeof rawHeaders !== 'string') return [];
      return rawHeaders
        .split('\n')
        .map(line => line.trim())
        .filter(Boolean)
        .map(line => {
          const sep = line.indexOf(':');
          if (sep === -1) return { key: line, value: '' };
          return {
            key: line.slice(0, sep).trim(),
            value: line.slice(sep + 1).trim()
          };
        })
        .filter(h => h.key);
    }

    function ensureExecuteDefaults(node) {
      if (!node || node.type !== 'execute') return;
      if (!node.data) node.data = {};
      if (!node.data.executeType) node.data.executeType = 'script';

      if (node.data.executeType === 'http') {
        if (!node.data.httpMethod) node.data.httpMethod = 'GET';
        if (!node.data.httpTimeoutMs) node.data.httpTimeoutMs = 30000;
        if (!node.data.httpAuthType) node.data.httpAuthType = 'none';
        if (!Array.isArray(node.data.httpHeaders)) node.data.httpHeaders = [];
        if (typeof node.data.httpBody !== 'string') node.data.httpBody = '';
        if (!node.icon || node.icon === 'settings') node.icon = 'http';
        if (node.data.actionName) {
          node.label = node.data.actionName;
        } else if (!node.label || node.label === 'Execute' || node.label.startsWith('Execute:')) {
          node.label = `HTTP ${node.data.httpMethod}`;
        }
      } else {
        if (!node.icon || node.icon === 'http') node.icon = 'settings';
        if (!node.data.scriptTimeoutMs) node.data.scriptTimeoutMs = 3600000;
        if (node.data.actionName) {
          node.label = node.data.actionName;
        } else if (!node.label || node.label === 'Execute' || node.label.startsWith('HTTP ')) {
          node.label = node.data.script ? `Execute: ${node.data.script.split('/').pop()}` : 'Execute Script';
        }
      }
    }

    function ensureWaitDefaults(node) {
      if (!node || node.type !== 'wait') return;
      if (!node.data) node.data = {};
      const waitSeconds = parseFloat(node.data.waitSeconds);
      node.data.waitSeconds = Number.isFinite(waitSeconds) && waitSeconds > 0 ? waitSeconds : 5;
      if (!node.icon || node.icon === 'device_hub') node.icon = 'schedule';
      if (node.data.actionName) {
        node.label = node.data.actionName;
      } else if (!node.label || node.label === 'Wait') {
        node.label = `Wait ${node.data.waitSeconds}s`;
      }
    }

    function ensureNotifyDefaults(node) {
      if (!node || node.type !== 'notify') return;
      if (!node.data) node.data = {};
      if (!node.data.notifyType) node.data.notifyType = 'INFORMATION';
      if (typeof node.data.notifyTitle !== 'string') node.data.notifyTitle = '';
      if (typeof node.data.notifyBody !== 'string') node.data.notifyBody = '';
      if (typeof node.data.notifyUrl !== 'string') node.data.notifyUrl = '';
      if (!node.icon || node.icon === 'device_hub') node.icon = 'notifications';
      if (node.data.actionName) {
        node.label = node.data.actionName;
      } else if (!node.label || node.label === 'Notify') {
        node.label = node.data.notifyTitle ? `Notify: ${node.data.notifyTitle}` : 'Notify';
      }
    }
    
    /**
     * Given a desired alias and the nodeId that will own it,
     * return the alias if unique, or append _2, _3, ... until it is.
     */
    function ensureUniqueAlias(desiredAlias, ownerNodeId) {
      if (!desiredAlias) return null;
      const existingAliases = {};
      Object.entries(nodes).forEach(([id, n]) => {
        if (id !== ownerNodeId && n.data && n.data.alias) {
          existingAliases[n.data.alias] = true;
        }
      });
      if (!existingAliases[desiredAlias]) return desiredAlias;
      let i = 2;
      while (existingAliases[`${desiredAlias}_${i}`]) i++;
      return `${desiredAlias}_${i}`;
    }

    /**
     * Scan all node data string fields and replace references to oldAlias with newAlias
     * in #{nodes.OLD_ALIAS.} patterns (rename-refactor).
     */
    function renameAliasReferences(oldAlias, newAlias) {
      if (!oldAlias || !newAlias || oldAlias === newAlias) return;
      const pattern = new RegExp(`#\\{nodes\\.${oldAlias.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\.`, 'g');
      const replacement = `#{nodes.${newAlias}.`;
      const scanFields = ['parameters', 'httpUrl', 'httpBody', 'notifyBody', 'notifyTitle', 'notifyUrl'];
      Object.values(nodes).forEach(n => {
        if (!n.data) return;
        scanFields.forEach(field => {
          if (typeof n.data[field] === 'string' && n.data[field].includes('#{nodes.')) {
            n.data[field] = n.data[field].replace(pattern, replacement);
          }
        });
        // Also scan httpHeaders values
        if (Array.isArray(n.data.httpHeaders)) {
          n.data.httpHeaders = n.data.httpHeaders.map(h => ({
            ...h,
            value: typeof h.value === 'string' ? h.value.replace(pattern, replacement) : h.value
          }));
        }
      });
    }

    /**
     * Normalise a node action name to a valid alias identifier.
     * Rules: lowercase, spaces/hyphens → underscore, strip non-[a-z0-9_],
     *        collapse multiple underscores, trim leading/trailing underscores.
     */
    function normalizeAlias(name) {
      return (name || '')
        .toLowerCase()
        .replace(/[\s\-]+/g, '_')
        .replace(/[^a-z0-9_]/g, '')
        .replace(/__+/g, '_')
        .replace(/^_+|_+$/g, '');
    }

    /**
     * Generate a unique alias for a new node of the given type.
     * Tries <type>_1, <type>_2, ... until unused.
     */
    function generateUniqueAlias(type) {
      const existingAliases = new Set(
        Object.values(nodes).map(n => n.data && n.data.alias).filter(Boolean)
      );
      const base = normalizeAlias(type) || 'node';
      let i = 1;
      while (existingAliases.has(`${base}_${i}`)) i++;
      return `${base}_${i}`;
    }

    function createNode(type, x = 100, y = 100, extraData = {}) {
      nodeIdCounter++;
      const id = 'node_' + nodeIdCounter;
      const resolvedType = type === 'execute-http' ? 'execute' : (type.startsWith('plugin:') ? 'plugin' : type);
      
      let label = 'Node';
      let icon = 'device_hub';
      let ports = [];
      let data = {};
      
      if (resolvedType === 'start') {
        label = 'Start';
        icon = 'play_arrow';
        ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
      } else if (resolvedType === 'execute') {
        const isHttpNode = type === 'execute-http';
        label = isHttpNode ? 'HTTP GET' : 'Execute Script';
        icon = isHttpNode ? 'http' : 'settings';
        ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
        data = isHttpNode ? {
          executeType: 'http',
          httpMethod: 'GET',
          httpUrl: '',
          httpTimeoutMs: 30000,
          httpHeaders: [],
          httpAuthType: 'none',
          httpBody: ''
        } : {
          executeType: 'script',
          scriptTimeoutMs: 3600000
        };
      } else if (resolvedType === 'wait') {
        label = 'Wait 5s';
        icon = 'schedule';
        ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
        data = {
          waitSeconds: 5
        };
      } else if (resolvedType === 'notify') {
        label = 'Notify';
        icon = 'notifications';
        ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
        data = {
          notifyType: 'INFORMATION',
          notifyTitle: '',
          notifyBody: '',
          notifyUrl: ''
        };
      } else if (resolvedType === 'condition') {
        label = 'if';
        icon = 'device_hub';
        // Condition nodes have labeled exit ports on left/right of diamond
        ports = [
          { id: 'true', label: 'true', x: -28, y: 0 },
          { id: 'false', label: 'false', x: 28, y: 0 }
        ];
      } else if (resolvedType === 'split-join') {
        label = 'Split/Join';
        icon = 'account_tree';
        ports = getSplitJoinPorts('split');
        data = {
          mode: 'split',
          joinStrategy: 'waitAll',
          errorPolicy: 'waitForAll'
        };
      } else if (resolvedType === 'end-success') {
        label = 'Success';
        icon = 'check_circle';
        ports = [];
      } else if (resolvedType === 'end-failure') {
        label = 'Failure';
        icon = 'error';
        ports = [];
      } else if (resolvedType === 'plugin') {
        const pluginName = extraData.pluginName || (type.startsWith('plugin:') ? type.split(':')[1] : '');
        const plugin = availablePlugins.find(function(p) { return p.name === pluginName; }) || {};
        label = plugin.label || pluginName || 'Plugin';
        icon = 'extension';
        ports = [{ id: 'out', label: 'next', x: CANVAS.nodeWidth / 2, y: CANVAS.nodeHeight }];
        data = { pluginName: pluginName, pluginTimeoutMs: 300000 };
      }
      
      nodes[id] = {
        id: id,
        type: resolvedType,
        label: label,
        icon: icon,
        x: x,
        y: y,
        ports: ports,
        data: data
      };

      // Assign a unique alias for action nodes that can be referenced in templates
      if (resolvedType === 'execute' || resolvedType === 'wait' || resolvedType === 'notify' || resolvedType === 'plugin') {
        nodes[id].data.alias = generateUniqueAlias(resolvedType);
      }

      ensureExecuteDefaults(nodes[id]);
  ensureWaitDefaults(nodes[id]);
  ensureNotifyDefaults(nodes[id]);
      
      renderNode(id);
      expandCanvasForNode(id);
      updateStats();
      commitHistorySnapshot();
    }
    
    function renderNode(nodeId) {
      const node = nodes[nodeId];
      if (!node) return;
      
      // Remove old rendering if exists
      const oldGrp = nodeLayer.querySelector(`[data-node-id="${nodeId}"]`);
      if (oldGrp) oldGrp.remove();
      
      // Create group
      const grp = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      grp.setAttribute('data-node-id', nodeId);
      grp.setAttribute('class', 'node');
      grp.style.cursor = 'move';
      
      // Calculate dynamic width based on label text (needed for all nodes)
      // Create temp text to measure width
      const tempText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      tempText.setAttribute('font-family', 'Arial, sans-serif');
      tempText.setAttribute('font-size', '14');
      tempText.setAttribute('font-weight', '500');
      tempText.textContent = node.label;
      nodeLayer.appendChild(tempText);
      const textWidth = tempText.getComputedTextLength();
      nodeLayer.removeChild(tempText);
      
      // Check node geometry type
      const isStartNode = node.type === 'start';
      const isEndNode = node.type === 'end-success' || node.type === 'end-failure';
      const isConditionNode = node.type === 'condition';
      const isSplitJoinNode = node.type === 'split-join';
      const isDiamondNode = isConditionNode || isSplitJoinNode;
      
      // Define nodeWidth for use in ports (for rectangular nodes)
      let nodeWidth = 200;
      if (!isStartNode && !isEndNode) {
        // Calculate node width: icon(18) + left pad(8) + text width + right pad(16)
        const minWidth = 200; // Minimum width
        const calculatedWidth = Math.max(minWidth, 18 + 8 + textWidth + 16);
        nodeWidth = calculatedWidth;
      }
      
      if (isDiamondNode) {
        // Diamond node rendering (conditionals)
        const diamondSize = 28; // same as circle radius
        
        // Draw diamond using polygon
        const diamond = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        const points = [
          [node.x, node.y - diamondSize],           // top
          [node.x + diamondSize, node.y],           // right
          [node.x, node.y + diamondSize],           // bottom
          [node.x - diamondSize, node.y]            // left
        ];
        diamond.setAttribute('points', points.map(p => p.join(',')).join(' '));
        diamond.setAttribute('fill', getCSSVariable('--surface-secondary', '#f9f9f9'));
        diamond.setAttribute('stroke', selectedNodes.has(nodeId) ? getCSSVariable('--warning-color', '#ff9800') : getCSSVariable('--border-color', '#e0e0e0'));
        diamond.setAttribute('stroke-width', selectedNodes.has(nodeId) ? '2' : '1');
        grp.appendChild(diamond);
        
        // Draw icon (above center in diamond)
        const icon = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        icon.setAttribute('x', node.x);
        icon.setAttribute('y', node.y - 6);
        icon.setAttribute('font-family', 'Material Icons');
        icon.setAttribute('font-size', '16');
        icon.setAttribute('pointer-events', 'none');
        icon.setAttribute('text-anchor', 'middle');
        icon.setAttribute('dominant-baseline', 'middle');
        icon.setAttribute('fill', getCSSVariable('--text-primary', '#333'));
        icon.textContent = isConditionNode ? 'call_split' : 'account_tree';
        if (isSplitJoinNode && (node.data?.mode || 'split') === 'join') {
          icon.setAttribute('transform', `translate(${node.x * 2} 0) scale(-1 1)`);
        }
        grp.appendChild(icon);
        
        // Draw label text (below icon, centered in diamond)
        const labelText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        labelText.setAttribute('x', node.x);
        labelText.setAttribute('y', node.y + 6);
        labelText.setAttribute('font-family', 'Arial, sans-serif');
        labelText.setAttribute('font-size', '12');
        labelText.setAttribute('font-weight', 'bold');
        labelText.setAttribute('pointer-events', 'none');
        labelText.setAttribute('text-anchor', 'middle');
        labelText.setAttribute('dominant-baseline', 'middle');
        labelText.setAttribute('fill', getCSSVariable('--text-primary', '#333'));
        if (isConditionNode) {
          labelText.textContent = node.label;
        } else {
          labelText.textContent = node.data?.mode === 'join' ? 'join' : 'split';
        }
        grp.appendChild(labelText);
        
      } else if (isStartNode) {
        // Circular start node rendering
        const circleRadius = 28;
        
        // Draw circle
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', node.x);
        circle.setAttribute('cy', node.y);
        circle.setAttribute('r', circleRadius);
        circle.setAttribute('fill', getCSSVariable('--surface-secondary', '#f9f9f9'));
        circle.setAttribute('stroke', selectedNodes.has(nodeId) ? getCSSVariable('--warning-color', '#ff9800') : getCSSVariable('--border-color', '#e0e0e0'));
        circle.setAttribute('stroke-width', selectedNodes.has(nodeId) ? '2' : '1');
        grp.appendChild(circle);
        
        // Draw icon (centered in circle)
        const icon = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        icon.setAttribute('x', node.x);
        icon.setAttribute('y', node.y - 2);
        icon.setAttribute('font-family', 'Material Icons');
        icon.setAttribute('font-size', '20');
        icon.setAttribute('pointer-events', 'none');
        icon.setAttribute('text-anchor', 'middle');
        icon.setAttribute('dominant-baseline', 'middle');
        
        // Set icon color based on node type
        if (node.type === 'start') {
          icon.setAttribute('fill', getCSSVariable('--success-color', '#4caf50'));
        } else if (node.type === 'end-success') {
          icon.setAttribute('fill', getCSSVariable('--success-color', '#4caf50'));
        } else if (node.type === 'end-failure') {
          icon.setAttribute('fill', getCSSVariable('--error-color', '#f44336'));
        }
        
        const iconMap = {
          'play_arrow': 'play_arrow',
          'settings': 'settings',
          'http': 'http',
          'schedule': 'schedule',
          'notifications': 'notifications',
          'device_hub': 'device_hub',
          'check_circle': 'check_circle',
          'error': 'error',
          'extension': 'extension'
        };
        icon.textContent = iconMap[node.icon] || 'device_hub';
        grp.appendChild(icon);
        
        // Draw label (below icon, inside/below circle)
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', node.x);
        text.setAttribute('y', node.y + 10);
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('dominant-baseline', 'middle');
        text.setAttribute('fill', getCSSVariable('--text-primary', '#333'));
        text.setAttribute('font-size', '9');
        text.setAttribute('font-weight', '500');
        text.setAttribute('pointer-events', 'none');
        text.textContent = node.label;
        grp.appendChild(text);

      } else if (isEndNode) {
        // Square end node rendering (same footprint as previous circular node diameter)
        const squareSize = 56;

        const square = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        square.setAttribute('x', node.x - squareSize / 2);
        square.setAttribute('y', node.y - squareSize / 2);
        square.setAttribute('width', squareSize);
        square.setAttribute('height', squareSize);
        square.setAttribute('fill', getCSSVariable('--surface-secondary', '#f9f9f9'));
        square.setAttribute('stroke', selectedNodes.has(nodeId) ? getCSSVariable('--warning-color', '#ff9800') : getCSSVariable('--border-color', '#e0e0e0'));
        square.setAttribute('stroke-width', selectedNodes.has(nodeId) ? '2' : '1');
        grp.appendChild(square);

        const icon = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        icon.setAttribute('x', node.x);
        icon.setAttribute('y', node.y - 2);
        icon.setAttribute('font-family', 'Material Icons');
        icon.setAttribute('font-size', '20');
        icon.setAttribute('pointer-events', 'none');
        icon.setAttribute('text-anchor', 'middle');
        icon.setAttribute('dominant-baseline', 'middle');

        if (node.type === 'end-success') {
          icon.setAttribute('fill', getCSSVariable('--success-color', '#4caf50'));
        } else if (node.type === 'end-failure') {
          icon.setAttribute('fill', getCSSVariable('--error-color', '#f44336'));
        }

        const iconMap = {
          'play_arrow': 'play_arrow',
          'settings': 'settings',
          'http': 'http',
          'schedule': 'schedule',
          'notifications': 'notifications',
          'device_hub': 'device_hub',
          'check_circle': 'check_circle',
          'error': 'error',
          'extension': 'extension'
        };
        icon.textContent = iconMap[node.icon] || 'device_hub';
        grp.appendChild(icon);

        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', node.x);
        text.setAttribute('y', node.y + 10);
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('dominant-baseline', 'middle');
        text.setAttribute('fill', getCSSVariable('--text-primary', '#333'));
        text.setAttribute('font-size', '9');
        text.setAttribute('font-weight', '500');
        text.setAttribute('pointer-events', 'none');
        text.textContent = node.label;
        grp.appendChild(text);
        
      } else {
        
        // Draw box with palette-like styling
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', node.x - nodeWidth / 2);
        rect.setAttribute('y', node.y - CANVAS.nodeHeight / 2);
        rect.setAttribute('width', nodeWidth);
        rect.setAttribute('height', CANVAS.nodeHeight);
        rect.setAttribute('fill', getCSSVariable('--surface-secondary', '#f9f9f9'));
        rect.setAttribute('stroke', selectedNodes.has(nodeId) ? getCSSVariable('--warning-color', '#ff9800') : getCSSVariable('--border-color', '#e0e0e0'));
        rect.setAttribute('stroke-width', selectedNodes.has(nodeId) ? '2' : '1');
        rect.setAttribute('rx', '4');
        grp.appendChild(rect);
        
        // Draw icon — use plugin SVG if available, otherwise Material Icons font
        const iconX = node.x - nodeWidth / 2 + 12;
        const iconY = node.y;
        let iconAppended = false;
        if (node.type === 'plugin') {
          const pluginDef = availablePlugins.find(function(p) { return p.name === (node.data && node.data.pluginName); });
          if (pluginDef && pluginDef.iconSvg) {
            const imgEl = document.createElementNS('http://www.w3.org/2000/svg', 'image');
            const iconSize = 20;
            imgEl.setAttribute('x', iconX - iconSize / 2);
            imgEl.setAttribute('y', iconY - iconSize / 2);
            imgEl.setAttribute('width', iconSize);
            imgEl.setAttribute('height', iconSize);
            imgEl.setAttribute('href', 'data:image/svg+xml,' + encodeURIComponent(pluginDef.iconSvg));
            imgEl.setAttribute('pointer-events', 'none');
            grp.appendChild(imgEl);
            iconAppended = true;
          }
        }
        if (!iconAppended) {
          const icon = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          icon.setAttribute('x', iconX);
          icon.setAttribute('y', iconY);
          icon.setAttribute('font-family', 'Material Icons');
          icon.setAttribute('font-size', '18');
          icon.setAttribute('pointer-events', 'none');
          icon.setAttribute('text-anchor', 'middle');
          icon.setAttribute('dominant-baseline', 'middle');
          if (node.type === 'start') {
            icon.setAttribute('fill', getCSSVariable('--success-color', '#4caf50'));
          } else if (node.type === 'end-success') {
            icon.setAttribute('fill', getCSSVariable('--success-color', '#4caf50'));
          } else if (node.type === 'end-failure') {
            icon.setAttribute('fill', getCSSVariable('--error-color', '#f44336'));
          } else {
            icon.setAttribute('fill', getCSSVariable('--text-muted', '#999'));
          }
          const iconMap = {
            'play_arrow': 'play_arrow',
            'settings': 'settings',
            'http': 'http',
            'schedule': 'schedule',
            'notifications': 'notifications',
            'device_hub': 'device_hub',
            'check_circle': 'check_circle',
            'error': 'error',
            'extension': 'extension'
          };
          icon.textContent = iconMap[node.icon] || 'device_hub';
          grp.appendChild(icon);
        }
        
        // Draw label (positioned to right of icon)
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', node.x - nodeWidth / 2 + 36);
        text.setAttribute('y', node.y);
        text.setAttribute('text-anchor', 'start');
        text.setAttribute('dominant-baseline', 'middle');
        text.setAttribute('fill', getCSSVariable('--text-primary', '#333'));
        text.setAttribute('font-size', '14');
        text.setAttribute('font-weight', '500');
        text.setAttribute('pointer-events', 'none');
        text.textContent = node.label;
        grp.appendChild(text);
      }
      
      // Draw ports with adjusted positions based on node type
      node.ports.forEach(port => {
        const portGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        portGroup.setAttribute('data-port', port.id);
        portGroup.style.cursor = 'crosshair';
        
        // Calculate port position based on node type
        let portX = port.x;
        let portY = port.y;
        let portAbsX, portAbsY;
        let labelOffsetX = 0, labelOffsetY = 20;
        
        if (isConditionNode) {
          // For diamond nodes, ports are already relative to center
          portAbsX = node.x + portX;
          portAbsY = node.y + portY;
          labelOffsetX = portX > 0 ? 20 : -20;  // offset label to outside
          labelOffsetY = 5;
        } else if (isSplitJoinNode) {
          portAbsX = node.x + portX;
          portAbsY = node.y + portY;
          labelOffsetX = 0;
          labelOffsetY = 18;
        } else if (isStartNode) {
          // For circular start nodes, port is at bottom center
          portAbsX = node.x;
          portAbsY = node.y + 28; // circle radius
        } else if (node.type === 'execute' || node.type === 'wait' || node.type === 'notify') {
          // Center port at bottom-center
          portAbsX = node.x;
          portAbsY = node.y + CANVAS.nodeHeight / 2;
        } else {
          // Default for rectangular nodes
          portAbsX = node.x + portX - nodeWidth / 2;
          portAbsY = node.y + portY - CANVAS.nodeHeight / 2;
        }
        
        // Port circle
        const portCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        portCircle.setAttribute('cx', portAbsX);
        portCircle.setAttribute('cy', portAbsY);
        portCircle.setAttribute('r', CANVAS.portRadius);
        portCircle.setAttribute('fill', getCSSVariable('--surface-color', '#fff'));
        portCircle.setAttribute('stroke', getCSSVariable('--border-color', '#333'));
        portCircle.setAttribute('stroke-width', '2');
        portGroup.appendChild(portCircle);
        
        // Port label
        const portLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        portLabel.setAttribute('x', portAbsX + labelOffsetX);
        portLabel.setAttribute('y', portAbsY + labelOffsetY);
        
        if (isConditionNode) {
          portLabel.setAttribute('text-anchor', labelOffsetX > 0 ? 'start' : 'end');
        } else {
          portLabel.setAttribute('text-anchor', 'middle');
        }
        portLabel.setAttribute('font-size', '11');
        portLabel.setAttribute('fill', getCSSVariable('--text-muted', '#666'));
        portLabel.setAttribute('pointer-events', 'none');

        const isNextPortLabel = (port.label || '').toLowerCase() === 'next';
        const hasOutgoingFromThisPort = edges.some(edge => edge.from === nodeId && edge.fromPort === port.id);

        // Hide "next" helper text once that port is connected to avoid overlapping edge visuals.
        if (!(isNextPortLabel && hasOutgoingFromThisPort)) {
          portLabel.textContent = port.label;
          portGroup.appendChild(portLabel);
        }
        
        portGroup.addEventListener('mousedown', (e) => startDrawEdge(e, nodeId, port.id));
        grp.appendChild(portGroup);
      });
      
      // Node interaction
      grp.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        // Only ignore if it's a port circle (parent has data-port attribute)
        if (e.target.tagName === 'circle' && e.target.parentElement.hasAttribute('data-port')) return;

        if (e.ctrlKey || e.metaKey) return;

        if (!selectedNodes.has(nodeId)) {
          selectedNodes.clear();
          selectedNodes.add(nodeId);
        }

        isDraggingNode = nodeId;
        selectedNode = nodeId;
        selectedEdge = null;

        const rect = svg.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * CANVAS.width;
        const y = ((e.clientY - rect.top) / rect.height) * CANVAS.height;
        dragStartMouse = { x, y };
        dragStartNodePositions = {};
        didDragMove = false;

        selectedNodes.forEach(id => {
          if (nodes[id]) {
            dragStartNodePositions[id] = { x: nodes[id].x, y: nodes[id].y };
          }
        });

        updatePropertiesPanel();
        renderAllNodes();
      });
      
      grp.addEventListener('click', (e) => {
        e.stopPropagation();

        if (e.ctrlKey || e.metaKey) {
          if (selectedNodes.has(nodeId)) {
            selectedNodes.delete(nodeId);
          } else {
            selectedNodes.add(nodeId);
          }

          if (selectedNodes.size === 1) {
            selectedNode = Array.from(selectedNodes)[0];
          } else if (selectedNodes.size > 1) {
            selectedNode = nodeId;
          } else {
            selectedNode = null;
          }
          selectedEdge = null;
          updatePropertiesPanel();
          renderAllNodes();
          return;
        }

        selectedNodes.clear();
        selectedNodes.add(nodeId);
        selectedNode = nodeId;
        selectedEdge = null;
        updatePropertiesPanel();
        renderAllNodes();
      });
      
      nodeLayer.appendChild(grp);
    }
    
    function renderAllNodes() {
      nodeLayer.querySelectorAll('[data-node-id]').forEach(el => el.remove());
      Object.keys(nodes).forEach(nodeId => renderNode(nodeId));
      expandCanvasForAllNodes();
      renderAllEdges();
    }
    
    function renderAllEdges() {
      edgeLayer.innerHTML = '';
      edges.forEach(edge => renderEdge(edge));
    }
    
    function renderEdge(edge) {
      const fromNode = nodes[edge.from];
      const toNode = nodes[edge.to];
      
      if (!fromNode || !toNode) return;
      
      const fromPort = fromNode.ports.find(p => p.id === edge.fromPort);
      const startPos = getPortPosition(fromNode, edge.fromPort);
      const startX = startPos.x;
      const startY = startPos.y;

      const targetIsStart = toNode.type === 'start';
      const targetIsEnd = toNode.type === 'end-success' || toNode.type === 'end-failure';
      const targetIsDiamond = toNode.type === 'condition' || toNode.type === 'split-join';
      const targetTopOffset = (targetIsStart || targetIsEnd || targetIsDiamond) ? 28 : (CANVAS.nodeHeight / 2);
      const endX = toNode.x;
      const endY = toNode.y - targetTopOffset;
      
      // Draw cubic bezier curve
      const midY = (startY + endY) / 2;
      const pathData = `M ${startX} ${startY} C ${startX} ${midY}, ${endX} ${midY}, ${endX} ${endY}`;
      
      // Determine edge color dynamically based on type
      let edgeColor = getCSSVariable('--primary-color', '#2196f3');
      if (edge.fromPort === 'true') {
        edgeColor = getCSSVariable('--success-color', '#4caf50');
      } else if (edge.fromPort === 'false') {
        edgeColor = getCSSVariable('--error-color', '#f44336');
      }

      const isSelected = selectedEdge === edge.id;
      const displayColor = isSelected ? getCSSVariable('--warning-color', '#ff9800') : edgeColor;

      const hitArea = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      hitArea.setAttribute('d', pathData);
      hitArea.setAttribute('stroke', 'transparent');
      hitArea.setAttribute('stroke-width', '14');
      hitArea.setAttribute('fill', 'none');
      hitArea.setAttribute('data-edge-id', edge.id);
      hitArea.style.cursor = 'pointer';
      hitArea.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedEdge = edge.id;
        selectedNode = null;
        selectedNodes.clear();
        updatePropertiesPanel();
        renderAllNodes();
      });
      edgeLayer.appendChild(hitArea);
      
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      line.setAttribute('d', pathData);
      line.setAttribute('stroke', displayColor);
      line.setAttribute('stroke-width', isSelected ? '4' : '2');
      line.setAttribute('fill', 'none');
      line.setAttribute('marker-end', 'url(#arrowhead)');
      line.style.pointerEvents = 'none';
      edgeLayer.appendChild(line);
      
      // Draw label
      // if (edge.label) {
      //   const labelText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      //   labelText.setAttribute('x', (startX + endX) / 2);
      //   labelText.setAttribute('y', midY - 8);
      //   labelText.setAttribute('text-anchor', 'middle');
      //   labelText.setAttribute('font-size', '11');
      //   labelText.setAttribute('fill', edgeColor);
      //   labelText.setAttribute('font-weight', 'bold');
      //   labelText.textContent = edge.label;
      //   edgeLayer.appendChild(labelText);
      // }
    }
    
    function startDrawEdge(e, fromNodeId, portId) {
      e.stopPropagation();
      e.preventDefault();
      
      isDrawingEdge = true;
      tempEdgeStartPort = { nodeId: fromNodeId, portId: portId };
      
      const node = nodes[fromNodeId];
      const startPos = getPortPosition(node, portId);
      const startX = startPos.x;
      const startY = startPos.y;
      
      tempEdgeLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      tempEdgeLine.setAttribute('stroke', getCSSVariable('--warning-color', '#ff9800'));
      tempEdgeLine.setAttribute('stroke-width', '2');
      tempEdgeLine.setAttribute('fill', 'none');
      tempEdgeLine.setAttribute('stroke-dasharray', '5,5');
      
      const pathData = `M ${startX} ${startY} L ${startX} ${startY}`;
      tempEdgeLine.setAttribute('d', pathData);
      edgeLayer.appendChild(tempEdgeLine);
      
      document.addEventListener('mousemove', updateTempEdgeLine);
    }
    
    function updateTempEdgeLine(e) {
      if (!isDrawingEdge || !tempEdgeLine || !tempEdgeStartPort) return;
      
      const startNode = nodes[tempEdgeStartPort.nodeId];
      const startPos = getPortPosition(startNode, tempEdgeStartPort.portId);
      const startX = startPos.x;
      const startY = startPos.y;
      
      const rect = svg.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * CANVAS.width;
      const y = ((e.clientY - rect.top) / rect.height) * CANVAS.height;
      
      const pathData = `M ${startX} ${startY} L ${x} ${y}`;
      tempEdgeLine.setAttribute('d', pathData);
    }
    
    function onSVGMouseUp(e) {
      if (isBoxSelecting) {
        finalizeBoxSelection();
        isDraggingNode = null;
        dragStartMouse = null;
        dragStartNodePositions = null;
        didDragMove = false;
        return;
      }

      if (!isDrawingEdge || !tempEdgeStartPort) {
        const shouldCommitDrag = Boolean(isDraggingNode && didDragMove);
        isDrawingEdge = false;
        if (tempEdgeLine) tempEdgeLine.remove();
        tempEdgeLine = null;
        tempEdgeStartPort = null;
        isDraggingNode = null;
        dragStartMouse = null;
        dragStartNodePositions = null;
        didDragMove = false;
        document.removeEventListener('mousemove', updateTempEdgeLine);
        if (shouldCommitDrag) commitHistorySnapshot();
        return;
      }
      
      // Check if dropped on another node
      const rect = svg.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * CANVAS.width;
      const y = ((e.clientY - rect.top) / rect.height) * CANVAS.height;
      
      let targetNode = null;
      for (let nodeId in nodes) {
        const node = nodes[nodeId];
        if (nodeId === tempEdgeStartPort.nodeId) continue;
        
        const dist = Math.sqrt(Math.pow(x - node.x, 2) + Math.pow(y - node.y, 2));
        if (dist < CANVAS.nodeHeight + 20) {
          targetNode = nodeId;
          break;
        }
      }
      
      isDrawingEdge = false;
      if (tempEdgeLine) tempEdgeLine.remove();
      tempEdgeLine = null;
      
      if (targetNode) {
        createEdge(tempEdgeStartPort.nodeId, targetNode, tempEdgeStartPort.portId);
      }
      
      tempEdgeStartPort = null;
      isDraggingNode = null;
      dragStartMouse = null;
      dragStartNodePositions = null;
      didDragMove = false;
      document.removeEventListener('mousemove', updateTempEdgeLine);
      renderAllEdges();
    }
    
    function onSVGMouseMove(e) {
      if (isBoxSelecting && boxSelectStart && boxSelectRect) {
        const point = getCanvasPointFromEvent(e);
        boxSelectStart.currentX = point.x;
        boxSelectStart.currentY = point.y;

        const minX = Math.min(boxSelectStart.x, point.x);
        const minY = Math.min(boxSelectStart.y, point.y);
        const width = Math.abs(point.x - boxSelectStart.x);
        const height = Math.abs(point.y - boxSelectStart.y);

        boxSelectRect.setAttribute('x', minX);
        boxSelectRect.setAttribute('y', minY);
        boxSelectRect.setAttribute('width', width);
        boxSelectRect.setAttribute('height', height);
        return;
      }

      if (isDraggingNode) {
        const rect = svg.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * CANVAS.width;
        const y = ((e.clientY - rect.top) / rect.height) * CANVAS.height;

        if (dragStartMouse && dragStartNodePositions && Object.keys(dragStartNodePositions).length > 0) {
          const deltaX = x - dragStartMouse.x;
          const deltaY = y - dragStartMouse.y;
          if (deltaX !== 0 || deltaY !== 0) didDragMove = true;

          Object.keys(dragStartNodePositions).forEach(nodeId => {
            if (!nodes[nodeId]) return;
            nodes[nodeId].x = dragStartNodePositions[nodeId].x + deltaX;
            nodes[nodeId].y = dragStartNodePositions[nodeId].y + deltaY;
          });
          expandCanvasForAllNodes();
        } else {
          nodes[isDraggingNode].x = x;
          nodes[isDraggingNode].y = y;
          didDragMove = true;
          expandCanvasForNode(isDraggingNode);
        }

        renderAllNodes();
      }
    }
    
    function onSVGClick(e) {
      if (suppressNextCanvasClick) {
        suppressNextCanvasClick = false;
        return;
      }

      if (e.target === svg || (e.target.tagName === 'g' && !e.target.hasAttribute('data-node-id'))) {
        closeDetailsPanel();
      }
    }

    function closeDetailsPanel(){
      selectedNode = null;
      selectedNodes.clear();
      selectedEdge = null;
      document.getElementById('orchestration-properties').classList.remove('show');
      document.getElementById('zoom-controls').classList.remove('shift-left');
      updatePropertiesPanel();
      renderAllNodes();
    }

    // ── Context Menu ─────────────────────────────────────────────────────────

    let _ctxMenuNodeId = null;
    let _ctxMenuEdgeId = null;

    function _ctxGetClickTarget(e) {
      let el = e.target;
      while (el && el !== svg) {
        if (el.hasAttribute && el.hasAttribute('data-node-id')) {
          return { type: 'node', id: el.getAttribute('data-node-id') };
        }
        if (el.hasAttribute && el.hasAttribute('data-edge-id')) {
          return { type: 'edge', id: el.getAttribute('data-edge-id') };
        }
        el = el.parentElement;
      }
      return { type: 'canvas' };
    }

    function onSVGContextMenu(e) {
      e.preventDefault();
      e.stopPropagation();

      const target = _ctxGetClickTarget(e);
      _ctxMenuNodeId = null;
      _ctxMenuEdgeId = null;

      if (target.type === 'node') {
        _ctxMenuNodeId = target.id;
        // Select and highlight the node so context is clear
        selectedNodes.clear();
        selectedNodes.add(_ctxMenuNodeId);
        selectedNode = _ctxMenuNodeId;
        selectedEdge = null;
        updatePropertiesPanel();
        renderAllNodes();
      } else if (target.type === 'edge') {
        _ctxMenuEdgeId = target.id;
        // Select the edge visually
        selectedEdge = target.id;
        selectedNode = null;
        selectedNodes.clear();
        updatePropertiesPanel();
        renderAllNodes();
      }

      const node = _ctxMenuNodeId ? nodes[_ctxMenuNodeId] : null;
      const isStartNode = node && node.type === 'start';
      const isOnNode = target.type === 'node';
      const isOnEdge = target.type === 'edge';
      const isOnCanvas = target.type === 'canvas';

      // Delete: disabled on blank canvas only
      _ctxSetDisabled('ctx-delete', isOnCanvas);
      // Clone: disabled unless on a non-start node
      _ctxSetDisabled('ctx-clone', !isOnNode || isStartNode);
      // Undo/Redo: reflect stack state
      _ctxSetDisabled('ctx-undo', undoStack.length <= 1);
      _ctxSetDisabled('ctx-redo', redoStack.length === 0);

      const menu = document.getElementById('canvas-context-menu');
      // Briefly show off-screen to measure height
      menu.style.visibility = 'hidden';
      menu.style.left = '0px';
      menu.style.top = '0px';
      menu.classList.add('visible');
      const menuW = menu.offsetWidth || 195;
      const menuH = menu.offsetHeight || 290;
      menu.style.visibility = '';

      const vpW = window.innerWidth;
      const vpH = window.innerHeight;
      let left = e.clientX;
      let top = e.clientY;

      // Flip up if near the bottom of the viewport
      if (top + menuH > vpH - 8) top = Math.max(0, top - menuH);
      // Clamp to right edge (don't let it overflow horizontally)
      if (left + menuW > vpW - 8) left = Math.max(0, vpW - menuW - 8);

      menu.style.left = left + 'px';
      menu.style.top = top + 'px';
    }

    function _ctxSetDisabled(id, disabled) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.toggle('ctx-disabled', disabled);
    }

    function hideContextMenu() {
      const menu = document.getElementById('canvas-context-menu');
      if (menu) menu.classList.remove('visible');
    }

    function ctxMenuDelete() {
      hideContextMenu();
      if (_ctxMenuNodeId) {
        selectedNode = _ctxMenuNodeId;
        deleteSelectedNode();
      } else if (_ctxMenuEdgeId) {
        selectedEdge = _ctxMenuEdgeId;
        deleteSelectedEdge();
      }
    }

    function ctxMenuClone() {
      hideContextMenu();
      if (!_ctxMenuNodeId) return;
      const source = nodes[_ctxMenuNodeId];
      if (!source || source.type === 'start') return;

      nodeIdCounter++;
      const newId = 'node_' + nodeIdCounter;
      const cloned = JSON.parse(JSON.stringify(source));
      cloned.id = newId;
      cloned.x = source.x + 60;
      cloned.y = source.y + 60;
      nodes[newId] = cloned;

      // Select the cloned node so the user can immediately configure it
      selectedNodes.clear();
      selectedNodes.add(newId);
      selectedNode = newId;
      selectedEdge = null;

      renderNode(newId);
      expandCanvasForNode(newId);
      updateStats();
      updatePropertiesPanel();
      renderAllNodes();
      commitHistorySnapshot();
      M.toast({ html: 'Node cloned' });
    }

    function ctxMenuUndo() {
      hideContextMenu();
      undoGraphChange();
    }

    function ctxMenuRedo() {
      hideContextMenu();
      redoGraphChange();
    }

    function ctxMenuZoomIn() {
      hideContextMenu();
      zoomLevel = Math.min(zoomLevel + 0.1, 3);
      applyZoom();
    }

    function ctxMenuZoomOut() {
      hideContextMenu();
      zoomLevel = Math.max(zoomLevel - 0.1, 0.5);
      applyZoom();
    }

    function ctxMenuZoomReset() {
      hideContextMenu();
      zoomLevel = 1;
      applyZoom();
    }

    function ctxMenuAutoLayout() {
      hideContextMenu();
      autoLayoutOrchestration();
    }

    // ── End Context Menu ─────────────────────────────────────────────────────

    function createEdge(fromId, toId, fromPort) {
      const fromNode = nodes[fromId];
      const allowMultiple = Boolean(fromNode && fromNode.type === 'split-join' && (fromNode.data?.mode || 'split') === 'split');

      // Enforce single connection per port except split mode split-join nodes.
      if (!allowMultiple) {
        edges = edges.filter(e => !(e.from === fromId && e.fromPort === fromPort));
      }
      
      edgeIdCounter++;
      const label = fromPort === 'out' ? 'next' : fromPort;
      
      edges.push({
        id: 'edge_' + edgeIdCounter,
        from: fromId,
        fromPort: fromPort,
        to: toId,
        label: label,
        color: fromPort === 'true' ? '#4caf50' : (fromPort === 'false' ? '#f44336' : '#2196f3')
      });

      selectedEdge = null;
      
      updateStats();
      renderAllEdges();
      commitHistorySnapshot();
    }

    function deleteSelectedEdge() {
      if (!selectedEdge) return false;

      const originalLength = edges.length;
      edges = edges.filter(edge => edge.id !== selectedEdge);
      const deleted = edges.length !== originalLength;
      selectedEdge = null;

      if (deleted) {
        renderAllEdges();
        updateStats();
        commitHistorySnapshot();
        M.toast({html: 'Connection deleted successfully'});
      }

      return deleted;
    }
    
    function deleteSelectedNode() {
      if (!selectedNode) return;
      
      const node = nodes[selectedNode];
      if (!node) return;
      
      // Populate modal with node information
      const nodeType = node.type.charAt(0).toUpperCase() + node.type.slice(1);
      document.getElementById('delete-node-type').textContent = nodeType;
      document.getElementById('delete-node-label').textContent = node.label || '(Untitled)';
      
      // Show extra info for specific node types
      let extraInfo = '';
      if (node.type === 'execute') {
        if ((node.data?.executeType || 'script') === 'http') {
          extraInfo = `<div><span style="font-size: 0.85em; color: #666; text-transform: uppercase;">HTTP:</span><strong style="display: block; margin-top: 2px; font-family: monospace; font-size: 0.9em;">${(node.data.httpMethod || 'GET')} ${node.data.httpUrl || '(URL not set)'}</strong></div>`;
        } else if (node.data?.script) {
          extraInfo = `<div><span style="font-size: 0.85em; color: #666; text-transform: uppercase;">Script:</span><strong style="display: block; margin-top: 2px; font-family: monospace; font-size: 0.9em;">${node.data.script}</strong></div>`;
        }
      } else if (node.type === 'wait') {
        extraInfo = `<div><span style="font-size: 0.85em; color: #666; text-transform: uppercase;">Delay:</span><strong style="display: block; margin-top: 2px; font-family: monospace; font-size: 0.9em;">${node.data?.waitSeconds || 5}s</strong></div>`;
      } else if (node.type === 'notify') {
        extraInfo = `<div><span style="font-size: 0.85em; color: #666; text-transform: uppercase;">Notification:</span><strong style="display: block; margin-top: 2px; font-family: monospace; font-size: 0.9em;">${node.data?.notifyType || 'INFORMATION'} - ${node.data?.notifyTitle || '(Title not set)'}</strong></div>`;
      } else if (node.type === 'condition') {
        extraInfo = `<div><span style="font-size: 0.85em; color: #666; text-transform: uppercase;">Condition:</span><strong style="display: block; margin-top: 2px; font-family: monospace; font-size: 0.9em;">${node.data.conditionType || 'N/A'}</strong></div>`;
      }
      document.getElementById('delete-node-extra-info').innerHTML = extraInfo;
      
      // Open the modal
      var modal = M.Modal.getInstance(document.getElementById('delete-node-confirmation-modal'));
      if (modal) {
        modal.open();
      } else {
        M.Modal.init(document.getElementById('delete-node-confirmation-modal')).open();
      }
    }
    
    function confirmDeleteNode() {
      if (!selectedNode) return;
      
      // Perform the actual deletion
      edges = edges.filter(e => e.from !== selectedNode && e.to !== selectedNode);
      delete nodes[selectedNode];
      selectedNode = null;
      selectedNodes.clear();
      selectedEdge = null;
      updatePropertiesPanel();
      renderAllNodes();
      shrinkCanvasToFitNodes();
      updateStats();
      commitHistorySnapshot();
      
      // Close the modal
      var modal = M.Modal.getInstance(document.getElementById('delete-node-confirmation-modal'));
      if (modal) {
        modal.close();
      }
      
      M.toast({html: 'Node deleted successfully'});
    }
    
    function updatePropertiesPanel() {
      const propsEmpty = document.getElementById('properties-empty');
      const propsContent = document.getElementById('properties-content');
      const propsPanel = document.getElementById('orchestration-properties');
      
      if (!selectedNode || !nodes[selectedNode] || selectedNodes.size !== 1 || !selectedNodes.has(selectedNode)) {
        propsEmpty.style.display = 'block';
        propsContent.style.display = 'none';
        propsPanel.classList.remove('show');
        document.getElementById('zoom-controls').classList.remove('shift-left');
        return;
      }
      
      const node = nodes[selectedNode];
      propsEmpty.style.display = 'none';
      propsContent.style.display = 'block';
      propsPanel.classList.add('show');
      document.getElementById('zoom-controls').classList.add('shift-left');
      
      const executeTypeLabel = node.type === 'execute' && (node.data?.executeType || 'script') === 'http'
        ? 'Execute (HTTP Request)'
        : (node.type === 'execute' ? 'Execute (Script)' : node.type === 'wait' ? 'Wait' : node.type === 'notify' ? 'Notification' : node.type === 'plugin' ? 'Plugin (' + (node.data?.pluginName || '') + ')' : node.type.charAt(0).toUpperCase() + node.type.slice(1));
      document.getElementById('prop-type').textContent = executeTypeLabel;
      
      document.getElementById('prop-execute').style.display = node.type === 'execute' ? 'block' : 'none';
      document.getElementById('prop-condition').style.display = node.type === 'condition' ? 'block' : 'none';
      document.getElementById('prop-split-join').style.display = node.type === 'split-join' ? 'block' : 'none';
      document.getElementById('prop-wait').style.display = node.type === 'wait' ? 'block' : 'none';
      document.getElementById('prop-notify').style.display = node.type === 'notify' ? 'block' : 'none';
      document.getElementById('prop-end').style.display = node.type.startsWith('end') ? 'block' : 'none';
      document.getElementById('prop-plugin').style.display = node.type === 'plugin' ? 'block' : 'none';
      document.getElementById('prop-start').style.display = node.type === 'start' ? 'block' : 'none';

      const isActionType = node.type === 'execute' || node.type === 'wait' || node.type === 'notify' || node.type === 'plugin';
      document.getElementById('prop-action-name-section').style.display = isActionType ? 'block' : 'none';
      
      if (node.type === 'execute') {
        ensureExecuteDefaults(node);

        const executeTypeSelect = document.getElementById('prop-execute-type');
        const scriptFieldWrap = document.getElementById('prop-execute-script-fields');
        const httpFieldWrap = document.getElementById('prop-execute-http-fields');

        const scriptSelect = document.getElementById('prop-script');
        const paramsField = document.getElementById('prop-params');
        const scriptInfo = document.getElementById('prop-script-info-detail');

        const httpMethod = document.getElementById('prop-http-method');
        const httpUrl = document.getElementById('prop-http-url');
        const httpTimeout = document.getElementById('prop-http-timeout');
        const httpHeaders = document.getElementById('prop-http-headers');
        const httpBody = document.getElementById('prop-http-body');
        const httpAuthType = document.getElementById('prop-http-auth-type');
        const httpAuthBearer = document.getElementById('prop-http-auth-bearer');
        const httpAuthUser = document.getElementById('prop-http-auth-user');
        const httpAuthPass = document.getElementById('prop-http-auth-pass');
        const httpAuthApiKeyHeader = document.getElementById('prop-http-auth-apikey-header');
        const httpAuthApiKeyValue = document.getElementById('prop-http-auth-apikey-value');

        const authBearerSection = document.getElementById('prop-http-auth-bearer-section');
        const authBasicSection = document.getElementById('prop-http-auth-basic-section');
        const authApiKeySection = document.getElementById('prop-http-auth-apikey-section');

        const updateExecuteNodeLabelIcon = () => {
          if (node.data.actionName) {
            node.label = node.data.actionName;
          } else if ((node.data.executeType || 'script') === 'http') {
            node.icon = 'http';
            const method = (node.data.httpMethod || 'GET').toUpperCase();
            const shortUrl = (node.data.httpUrl || '').trim();
            node.label = shortUrl ? `HTTP ${method}: ${shortUrl}` : `HTTP ${method}`;
          } else {
            node.icon = 'settings';
            node.label = 'Execute: ' + (node.data.script ? node.data.script.split('/').pop() : 'Script');
          }
          renderNode(selectedNode);
        };

        const updateExecuteTypeVisibility = () => {
          const executeType = executeTypeSelect.value || 'script';
          node.data.executeType = executeType;
          const isHttp = executeType === 'http';
          scriptFieldWrap.style.display = isHttp ? 'none' : 'block';
          httpFieldWrap.style.display = isHttp ? 'block' : 'none';
          if (isHttp) {
            scriptInfo.innerHTML = '';
          }
          updateExecuteNodeLabelIcon();
          document.getElementById('prop-type').textContent = isHttp ? 'Execute (HTTP Request)' : 'Execute (Script)';
        };

        const updateHttpAuthVisibility = () => {
          const authType = httpAuthType.value || 'none';
          authBearerSection.style.display = authType === 'bearer' ? 'block' : 'none';
          authBasicSection.style.display = authType === 'basic' ? 'block' : 'none';
          authApiKeySection.style.display = authType === 'apiKey' ? 'block' : 'none';
        };

        executeTypeSelect.value = node.data.executeType || 'script';

        // Wire up action name field
        const actionNameField = document.getElementById('prop-action-name');
        const aliasDisplay = document.getElementById('prop-alias-display');
        actionNameField.value = node.data.actionName || '';
        if (aliasDisplay) aliasDisplay.textContent = node.data.alias ? `#{nodes.${node.data.alias}.*}` : '';
        actionNameField.oninput = function() {
          node.data.actionName = this.value.trim();
          // Regenerate alias from name, ensure uniqueness, rename-refactor references
          if (node.data.actionName) {
            const newAlias = ensureUniqueAlias(normalizeAlias(node.data.actionName), selectedNode);
            if (newAlias && newAlias !== node.data.alias) {
              renameAliasReferences(node.data.alias, newAlias);
              node.data.alias = newAlias;
            }
          }
          if (aliasDisplay) aliasDisplay.textContent = node.data.alias ? `#{nodes.${node.data.alias}.*}` : '';
          updateExecuteNodeLabelIcon();
        };
        actionNameField.onchange = function() {
          node.data.actionName = this.value.trim();
          updateExecuteNodeLabelIcon();
        };
        
        // Build script select options
        scriptSelect.innerHTML = '<option value="">Select a script...</option>';
        availableScripts.forEach(script => {
          const option = document.createElement('option');
          // Handle both object format {id, name, filename} and string format
          const scriptId = typeof script === 'string' ? script : (script.filename || script.id);
          const scriptDisplay = typeof script === 'string' ? script : (script.name || script.filename || script.id);
          option.value = scriptId;
          option.textContent = scriptDisplay;
          if (node.data.script === scriptId) option.selected = true;
          
          // Add hover behavior to preview script info in the panel
          option.addEventListener('mouseenter', function() {
            if (scriptId) {
              fetchScriptInfo(scriptId);
            }
          });
          
          scriptSelect.appendChild(option);
        });
        
        // Set parameters value
        paramsField.value = node.data.parameters || '';

        // Populate HTTP fields
        httpMethod.value = (node.data.httpMethod || 'GET').toUpperCase();
        httpUrl.value = node.data.httpUrl || '';
        httpTimeout.value = node.data.httpTimeoutMs || 30000;
        httpHeaders.value = headersToMultiline(node.data.httpHeaders || []);
        httpBody.value = node.data.httpBody || '';
        httpAuthType.value = node.data.httpAuthType || 'none';
        httpAuthBearer.value = node.data.httpAuthBearerToken || '';
        httpAuthUser.value = node.data.httpAuthUsername || '';
        httpAuthPass.value = node.data.httpAuthPassword || '';
        httpAuthApiKeyHeader.value = node.data.httpAuthApiKeyHeader || 'X-API-Key';
        httpAuthApiKeyValue.value = node.data.httpAuthApiKeyValue || '';
        updateHttpAuthVisibility();
        
        // Show current script info on focus
        scriptSelect.addEventListener('focus', function() {
          if (node.data.script) {
            fetchScriptInfo(node.data.script);
          }
        });
        
        scriptSelect.onchange = function() {
          node.data.script = this.value;
          updateExecuteNodeLabelIcon();
          if (this.value) {
            fetchScriptInfo(this.value);
          } else {
            document.getElementById('prop-script-info-detail').innerHTML = '';
          }
        };
        
        // Fetch and display info for currently selected script
        if ((node.data.executeType || 'script') === 'script' && node.data.script) {
          fetchScriptInfo(node.data.script);
        }
        
        paramsField.onchange = function() {
          node.data.parameters = this.value;
        };
        
        paramsField.oninput = function() {
          node.data.parameters = this.value;
        };

        // Script timeout handling
        const scriptTimeoutField = document.getElementById('prop-script-timeout');
        scriptTimeoutField.value = node.data.scriptTimeoutMs || 3600000;
        
        scriptTimeoutField.onchange = function() {
          const timeoutValue = parseInt(this.value, 10);
          node.data.scriptTimeoutMs = Number.isFinite(timeoutValue) && timeoutValue > 0 ? timeoutValue : 3600000;
        };
        
        scriptTimeoutField.oninput = function() {
          const timeoutValue = parseInt(this.value, 10);
          node.data.scriptTimeoutMs = Number.isFinite(timeoutValue) && timeoutValue > 0 ? timeoutValue : 3600000;
        };

        executeTypeSelect.onchange = updateExecuteTypeVisibility;

        httpMethod.onchange = function() {
          node.data.httpMethod = this.value;
          updateExecuteNodeLabelIcon();
        };
        httpUrl.onchange = function() {
          node.data.httpUrl = this.value;
          updateExecuteNodeLabelIcon();
        };
        httpUrl.oninput = function() {
          node.data.httpUrl = this.value;
        };
        httpTimeout.onchange = function() {
          const timeoutValue = parseInt(this.value, 10);
          node.data.httpTimeoutMs = Number.isFinite(timeoutValue) && timeoutValue > 0 ? timeoutValue : 30000;
        };
        httpHeaders.onchange = function() {
          node.data.httpHeaders = parseHeadersMultiline(this.value);
        };
        httpHeaders.oninput = function() {
          node.data.httpHeaders = parseHeadersMultiline(this.value);
        };
        httpBody.onchange = function() {
          node.data.httpBody = this.value;
        };
        httpBody.oninput = function() {
          node.data.httpBody = this.value;
        };
        httpAuthType.onchange = function() {
          node.data.httpAuthType = this.value;
          updateHttpAuthVisibility();
        };
        httpAuthBearer.onchange = function() {
          node.data.httpAuthBearerToken = this.value;
        };
        httpAuthBearer.oninput = function() {
          node.data.httpAuthBearerToken = this.value;
        };
        httpAuthUser.onchange = function() {
          node.data.httpAuthUsername = this.value;
        };
        httpAuthUser.oninput = function() {
          node.data.httpAuthUsername = this.value;
        };
        httpAuthPass.onchange = function() {
          node.data.httpAuthPassword = this.value;
        };
        httpAuthPass.oninput = function() {
          node.data.httpAuthPassword = this.value;
        };
        httpAuthApiKeyHeader.onchange = function() {
          node.data.httpAuthApiKeyHeader = this.value;
        };
        httpAuthApiKeyHeader.oninput = function() {
          node.data.httpAuthApiKeyHeader = this.value;
        };
        httpAuthApiKeyValue.onchange = function() {
          node.data.httpAuthApiKeyValue = this.value;
        };
        httpAuthApiKeyValue.oninput = function() {
          node.data.httpAuthApiKeyValue = this.value;
        };
        
        // Setup agent selection
        const agentSelect = document.getElementById('prop-agent');
        agentSelect.innerHTML = '<option value="">Select a target agent...</option>';
        availableAgents.forEach(agent => {
